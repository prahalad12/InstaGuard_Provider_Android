<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame_launch"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="com.instaguard.provider.Activities.HomeActivity">

    <FrameLayout
        android:id="@+id/frame_launch_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        tools:context="com.instaguard.provider.Activities.HomeActivity">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="UselessParent">

            <android.widget.Toolbar
                android:id="@+id/toolbar_launch"
                android:layout_width="match_parent"
                android:layout_height="?android:attr/actionBarSize"
                android:layout_alignParentTop="true"
                android:background="@drawable/bg_toolbar_gradient"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/button_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:contentDescription="@string/todo"
                    android:padding="10dp"
                    android:visibility="gone" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:text="@string/welcome_to_product_name"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:visibility="visible"
                    tools:ignore="MissingPrefix" />

            </android.widget.Toolbar>

            <RelativeLayout
                android:id="@+id/rl_launchheader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/toolbar_launch"
                android:background="@drawable/bg_toolbar_gradient"
                tools:context="com.instaguard.provider.Activities.HomeActivity"
                tools:ignore="UselessParent">

                <RelativeLayout
                    android:id="@+id/ll_launchheader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@+id/view__"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical"
                    tools:ignore="UselessParent">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_marginTop="30dp"
                        android:gravity="center"
                        android:text="@string/welcome_to_product_name"
                        android:textAllCaps="true"
                        android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
                        android:textColor="@color/white"
                        android:visibility="gone"
                        tools:ignore="MissingPrefix" />

                    <ImageView
                        android:id="@+id/iv_scar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center"
                        android:layout_marginStart="35dp"
                        android:layout_marginTop="35dp"
                        android:layout_marginEnd="35dp"
                        android:layout_marginBottom="15dp"
                        android:background="@drawable/com_facebook_button_background"
                        android:backgroundTint="@color/white"
                        android:contentDescription="@string/todo"
                        android:padding="20dp"
                        android:src="@drawable/logo_trans"
                        android:visibility="visible" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_welcom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="5dp"
                        android:gravity="center"
                        android:padding="5dp"
                        android:text="@string/welcome_to_product_name"
                        android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
                        android:textColor="@color/black"
                        android:visibility="gone"
                        tools:ignore="MissingPrefix,RtlHardcoded" />


                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/ll_cur_lang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_language"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lang_border"
                        android:drawableEnd="@drawable/ic_arrow_drop_down_black"
                        android:paddingEnd="10dp"
                        android:text="@string/home_english_lng_txxt"
                        android:textColor="@color/black"
                        tools:ignore="MissingPrefix,RtlHardcoded,RtlSymmetry" />

                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_currency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lang_border"
                        android:drawableEnd="@drawable/ic_arrow_drop_down_black"
                        android:paddingEnd="10dp"
                        android:text="@string/home_usd_text"
                        android:textColor="@color/black"
                        tools:ignore="MissingPrefix,RtlHardcoded,RtlSymmetry" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/view__"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    tools:targetApi="m">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.4dp"
                        android:layout_marginBottom="5dp"
                        android:background="@color/black"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/view_"
                        android:layout_width="match_parent"
                        android:layout_height="0.4dp"
                        android:background="@color/black"
                        android:visibility="gone" />


                    <LinearLayout
                        android:id="@+id/ll_social_logins"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="visible"
                        android:weightSum="2">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:padding="5dp"
                            android:text="@string/continue_with"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btn_facebook_"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginStart="20dp"
                                android:layout_marginEnd="15dp"
                                android:background="@drawable/ic_shape_circle"
                                android:backgroundTint="@color/com_facebook_button_background_color"
                                android:contentDescription="@string/todo"
                                android:src="@drawable/com_facebook_button_icon"
                                android:text="@string/home_login_btn_text"
                                android:textColor="@color/black"
                                android:visibility="visible" />

                            <ImageButton
                                android:id="@+id/btn_google_"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginStart="20dp"
                                android:layout_marginEnd="15dp"
                                android:background="@drawable/ic_shape_circle"
                                android:backgroundTint="@color/white"
                                android:contentDescription="@string/todo"
                                android:src="@drawable/googleg_standard_color_18"
                                android:text="@string/home_login_btn_text"
                                android:textColor="@color/black"
                                android:visibility="visible" />

                            <ImageButton
                                android:id="@+id/btn_twitter_"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginStart="20dp"
                                android:layout_marginEnd="20dp"
                                android:background="@drawable/ic_shape_circle"
                                android:backgroundTint="#000"
                                android:contentDescription="@string/todo"
                                android:padding="5dp"
                                android:scaleType="center"
                                android:src="@drawable/twitter_black"
                                android:visibility="gone"
                                app:tint="@color/white" />

                            <ImageButton
                                android:id="@+id/btn_linked_in_"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginStart="20dp"
                                android:layout_marginEnd="20dp"
                                android:background="@drawable/ic_shape_circle"
                                android:backgroundTint="#2666c2"
                                android:contentDescription="@string/todo"
                                android:padding="5dp"
                                android:scaleType="center"
                                android:src="@drawable/linkedin"
                                android:visibility="visible"
                                app:tint="@color/white" />

                        </LinearLayout>


                        <com.facebook.login.widget.LoginButton
                            android:id="@+id/loginButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:layout_margin="10dp"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:visibility="gone" />

                        <View
                            android:layout_width="0.4dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/white"
                            android:visibility="gone" />

                        <com.instaguard.provider.CustomViews.CustomButton
                            android:id="@+id/btn_google"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/com_facebook_button_background"
                            android:backgroundTint="@color/white"
                            android:drawableStart="@drawable/googleg_standard_color_18"
                            android:drawablePadding="5dp"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="Continue with Google"
                            android:textAllCaps="false"
                            android:textColor="@color/black"
                            android:visibility="gone" />

                        <com.instaguard.provider.CustomViews.CustomButton
                            android:id="@+id/btn_twitte"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/com_facebook_button_background"
                            android:backgroundTint="@color/black"
                            android:drawableStart="@drawable/twitter_white"
                            android:drawablePadding="25dp"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="25dp"
                            android:text="Continue with X"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:visibility="gone" />

                        <!--<com.twitter.sdk.android.core.identity.TwitterLoginButton
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginBottom="10dp"
                            android:visibility="gone" />-->

                        <com.google.android.gms.common.SignInButton
                            android:id="@+id/iv_google"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:textAlignment="center"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/iv_facebook_"
                            android:layout_width="50.0dip"
                            android:layout_height="50.0dip"
                            android:layout_marginEnd="44.0dip"
                            android:contentDescription="@string/todo"
                            android:src="@mipmap/facebook"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/iv_twitter"
                            android:layout_width="50.0dip"
                            android:layout_height="50.0dip"
                            android:layout_marginEnd="44.0dip"
                            android:contentDescription="@string/todo"
                            android:src="@mipmap/twitter"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/iv_google_"
                            android:layout_width="50.0dip"
                            android:layout_height="50.0dip"
                            android:contentDescription="@string/todo"
                            android:src="@mipmap/google"
                            android:visibility="gone" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:alpha="0.5"
                        android:background="@android:color/white"
                        android:visibility="gone" />

                    <RelativeLayout
                        android:id="@+id/rl_or"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:visibility="visible">

                        <View
                            android:layout_width="fill_parent"
                            android:layout_height="0.5dip"
                            android:layout_alignParentStart="true"
                            android:layout_centerInParent="true"
                            android:layout_marginStart="45dp"
                            android:layout_marginEnd="15dp"
                            android:layout_toStartOf="@+id/orTxt"
                            android:alpha="0.6"
                            android:background="#fff" />

                        <View
                            android:layout_width="fill_parent"
                            android:layout_height="0.5dip"
                            android:layout_alignParentEnd="true"
                            android:layout_centerInParent="true"
                            android:layout_marginStart="15dp"
                            android:layout_marginEnd="45dp"
                            android:layout_toEndOf="@+id/orTxt"
                            android:alpha="0.6"
                            android:background="#fff" />

                        <ImageView
                            android:layout_width="30.0dip"
                            android:layout_height="30.0dip"
                            android:layout_centerInParent="true"
                            android:contentDescription="@string/todo"
                            android:rotation="-45.0"
                            android:src="@drawable/ic_square_white"
                            android:visibility="gone" />

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/orTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_marginTop="15.0dip"
                            android:gravity="center"
                            android:padding="5.0dip"
                            android:text="OR"
                            android:textColor="@color/white"
                            android:textSize="12.0sp" />

                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/ll_signin_signup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="vertical">

                        <com.instaguard.provider.CustomViews.CustomButton
                            android:id="@+id/btn_signup"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginStart="35dp"
                            android:layout_marginEnd="35dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/com_facebook_button_background"
                            android:backgroundTint="@color/white"
                            android:text="@string/home_register_btn_text"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <com.instaguard.provider.CustomViews.CustomButton
                            android:id="@+id/btn_signin"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:background="@android:color/transparent"
                            android:padding="5dp"
                            android:text="@string/register_already_have_account_text"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0.4dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="5dp"
                            android:background="@color/white"
                            android:visibility="gone" />

                    </LinearLayout>

                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="10dp"
                        android:background="@android:color/white" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/btn_copyrights"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="5dp"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/ic_copyright_black_24dp"
                        android:drawablePadding="2dp"
                        android:drawableTint="@color/white"
                        android:gravity="center|start|center_vertical|center_horizontal"
                        android:padding="12dp"
                        android:text="@string/app_copy_rights_text"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </RelativeLayout>

        </RelativeLayout>

    </FrameLayout>

    <include
        android:id="@+id/location_request"
        layout="@layout/location_request"
        android:visibility="gone" />

    <include
        android:id="@+id/lyt_progressBar_view"
        layout="@layout/layout_progressbar_view"
        android:visibility="gone" />

</RelativeLayout>