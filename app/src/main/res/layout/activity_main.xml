<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <include
        android:id="@+id/lyt_online_offline"
        layout="@layout/layout_online_offline"
        android:visibility="visible" />

    <include
        android:id="@+id/lyt_job_inprogress"
        layout="@layout/layout_job_inprogress"
        android:visibility="gone" />


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Activities.MainActivity">

        <android.widget.Toolbar
            android:id="@+id/toolbar_checkin"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@android:color/white"
            android:elevation="10dp"
            android:visibility="gone"
            app:contentInsetLeft="20dp"
            app:contentInsetStart="20dp"
            app:contentInsetStartWithNavigation="20dp"
            tools:ignore="UnusedAttribute">

            <ImageView
                android:id="@+id/img_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="@string/todo"
                android:onClick="menubuttonClick"
                android:padding="5dp"
                android:src="@drawable/ic_menu_black"
                tools:ignore="content_description" />

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/app_name"
                android:textAllCaps="true"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/save_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center"
                android:layout_marginEnd="10dp"
                android:text="@string/app_name"
                android:textColor="@color/map_header_text"
                android:textSize="16sp"
                android:visibility="gone" />

        </android.widget.Toolbar>

        <FrameLayout
            android:id="@+id/frame_mainactivity"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </RelativeLayout>


    <!--Change for Intent service Its call for All pages -->

    <include
        android:id="@+id/lyt_request_receive"
        layout="@layout/layout_receive_request"
        android:visibility="gone" />

    <include
        android:id="@+id/lyt_sms_alert"
        layout="@layout/layout_sms_alert"
        android:visibility="gone" />

    <include
        android:id="@+id/location_request"
        layout="@layout/location_request"
        android:visibility="gone" />


    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationview"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/nav_background"
        android:fitsSystemWindows="true"
        android:theme="@style/NavigationTheme"
        app:headerLayout="@layout/navigation_header"
        app:itemHorizontalPadding="20dp"
        app:itemIconPadding="20dp"
        app:itemIconTint="@color/colorPrimaryDark"
        app:itemTextAppearance="@style/NavDrawerTextStyle"
        app:menu="@menu/drawer_menu">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/rl_signout_customer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/bg_toolbar_gradient_bottom_top"
                android:padding="15dp">

                <ImageView
                    android:id="@+id/img_logout"
                    style="@style/AppThemeNavDrawerHeaderFooter"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/todo"
                    android:src="@mipmap/ic_menu_logout" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_logout"
                    style="@style/AppThemeNavDrawerHeaderFooter"
                    android:layout_width="match_parent"
                    android:layout_height="29dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="10dp"
                    android:layout_toEndOf="@+id/img_logout"
                    android:foregroundGravity="center"
                    android:gravity="center|start"
                    android:paddingStart="20dp"
                    android:text="@string/nav_logout"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                    android:textStyle="bold" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_version"
                    style="@style/AppThemeNavDrawerHeaderFooter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/img_logout"
                    android:layout_alignBottom="@+id/img_logout"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:text="@string/v1_0_0"
                    android:textSize="12sp" />

            </RelativeLayout>

        </RelativeLayout>

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>

