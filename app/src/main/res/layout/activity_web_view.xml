<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activities.WebViewActivity">

    <android.widget.Toolbar
        android:id="@+id/toolbar_setting"
        android:layout_width="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@drawable/bg_toolbar_gradient">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/imgbtn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:contentDescription="@string/todo"
                style="@style/AppThemeToolBar"
                android:padding="10dp"
                android:src="@drawable/ic_back_whitearrow" />

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/imgbtn_back"
                android:layout_alignBottom="@+id/imgbtn_back"
                android:layout_centerInParent="true"
                android:layout_marginStart="0dp"
                android:layout_toStartOf="@+id/iv_menu_profile"
                android:layout_toEndOf="@+id/imgbtn_back"
                android:foregroundGravity="center"
                android:gravity="center|start"
                android:text="Add Bank Details"
                style="@style/AppThemeToolBar"
                tools:ignore="MissingPrefix" />

            <ImageView
                android:id="@+id/iv_menu_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="top|right"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/ic_menu_vertical"
                android:contentDescription="@string/todo"
                android:padding="5dp"
                android:visibility="gone"
                tools:ignore="RtlHardcoded" />
        </RelativeLayout>

    </android.widget.Toolbar>

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_setting"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteX="8dp"
        tools:layout_editor_absoluteY="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>