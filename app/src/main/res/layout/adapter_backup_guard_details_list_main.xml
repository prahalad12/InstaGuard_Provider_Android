<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_old_job_inorogress_views"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rect_filled_colorprimary"
        android:backgroundTint="@color/primary_blue_light_alpha"
        android:orientation="vertical">

        <com.instaguard.provider.Helpers.ExpansionPanelLayout.ExpansionHeader
            android:id="@+id/expHeader_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="5dp"
            app:expansion_headerIndicator="@id/headerIndicator"
            app:expansion_layout="@id/expansionLayout"
            app:expansion_toggleOnClick="true">

            <RelativeLayout
                android:id="@+id/ll_job_driver_details"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5.0dip"
                android:visibility="visible">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/iv_count"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_circle_elevation_white"
                    android:contentDescription="@string/todo"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/iv_user_prof_pic_job_inprogress"
                    android:layout_width="45.0dip"
                    android:layout_height="45.0dip"
                    android:layout_alignParentStart="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dip"
                    android:layout_marginEnd="5dip"
                    android:layout_toEndOf="@+id/iv_count"
                    android:background="@drawable/logo_circle"
                    android:scaleType="fitXY"
                    app:placeholderImage="@mipmap/male"
                    app:placeholderImageScaleType="fitXY"
                    app:roundedCornerRadius="0dp" />

                <LinearLayout
                    android:id="@+id/txt_Driver_info_label"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dip"
                    android:layout_marginEnd="0dip"
                    android:layout_marginBottom="10dip"
                    android:layout_toStartOf="@+id/ll_call_msg_lyt"
                    android:layout_toEndOf="@+id/iv_user_prof_pic_job_inprogress"
                    android:orientation="vertical">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_username_job_inprogress"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:layout_marginStart="5.0dip"
                        android:gravity="start|center"
                        android:maxLines="2"
                        android:text="@string/app_name"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.instaguard.provider.Helpers.RatingBar.SimpleRatingBar
                        android:id="@+id/ratingbar_job_inprogress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:clickable="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:padding="2.0dip"
                        app:srb_borderColor="@color/colorPrimary"
                        app:srb_fillColor="@color/colorPrimaryDark"
                        app:srb_numberOfStars="5"
                        app:srb_rating="4.5"
                        app:srb_starBorderWidth="2"
                        app:srb_starSize="14sp"
                        app:srb_stepSize="0.5" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_call_msg_lyt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerInParent="true"
                    android:gravity="center|end"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_phone"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="center|start"
                        android:layout_margin="3dp"
                        android:background="@drawable/ic_circle_elevation_white"
                        android:contentDescription="@string/todo"
                        android:padding="11dp"
                        android:src="@drawable/ic_baseline_phone_24"
                        android:visibility="gone"
                        app:tint="@color/colorPrimaryDark" />

                    <ImageView
                        android:id="@+id/img_message"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="center|end"
                        android:layout_margin="3dp"
                        android:background="@drawable/ic_circle_elevation_white"
                        android:contentDescription="@string/todo"
                        android:padding="11dp"
                        android:src="@drawable/ic_baseline_message_24"
                        android:visibility="gone"
                        app:tint="@color/colorPrimaryDark" />

                    <ImageView
                        android:id="@+id/headerIndicator"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/ic_circle_elevation_white"
                        android:contentDescription="@string/todo"
                        android:padding="8dp"
                        android:src="@drawable/ic_expansion_header_indicator_grey_24dp"
                        android:visibility="visible" />

                </LinearLayout>

            </RelativeLayout>

        </com.instaguard.provider.Helpers.ExpansionPanelLayout.ExpansionHeader>

        <com.instaguard.provider.Helpers.ExpansionPanelLayout.ExpansionLayout
            android:id="@+id/expansionLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:expansion_expanded="true">

            <LinearLayout
                android:id="@+id/ll_guard_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_trip_one"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:layout_width="35sp"
                        android:layout_height="35sp"
                        android:layout_gravity="center|start"
                        android:layout_margin="5dp"
                        android:background="@drawable/ic_circle_color_gray"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="35sp"
                        android:layout_height="35sp"
                        android:layout_margin="5dp"
                        android:layout_weight="0.0"
                        android:background="@drawable/ic_circle_color_gray"
                        android:backgroundTint="@color/white"
                        android:contentDescription="@string/todo"
                        android:padding="10dp"
                        android:src="@drawable/ic_greendot"
                        android:visibility="gone"
                        app:tint="@color/colorPrimary" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_accept_one"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:gravity="center|start"
                            android:text="@string/map_status_count_driver_accepted_the_request"
                            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                            android:textColor="@color/black" />

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_accept_time_one"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/txt_accept_one"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:gravity="center|start"
                            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                            android:textColor="@color/white" />

                    </RelativeLayout>

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_min_ago_one"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="0.0"
                        android:contentDescription="@string/todo"
                        android:text="@string/_4_min_ago"
                        android:textColor="@color/text_color_dark"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_trip_two"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:layout_width="35sp"
                        android:layout_height="35sp"
                        android:layout_gravity="center|start"
                        android:layout_margin="5dp"
                        android:background="@drawable/ic_circle_color_gray"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="35sp"
                        android:layout_height="35sp"
                        android:layout_margin="5dp"
                        android:layout_weight="0.0"
                        android:background="@drawable/ic_circle_color_gray"
                        android:backgroundTint="@color/white"
                        android:contentDescription="@string/todo"
                        android:padding="10dp"
                        android:src="@drawable/ic_greendot"
                        android:visibility="gone"
                        app:tint="@color/colorPrimary" />


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_accept_two"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:gravity="center|start"
                            android:text="@string/map_status_count_Driver_has_started_the_trip_to_your_location"
                            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                            android:textColor="@color/black" />

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_accept_time_two"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/txt_accept_two"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:gravity="center|start"
                            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                            android:textColor="@color/white" />

                    </RelativeLayout>

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_min_ago_two"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="0.0"
                        android:contentDescription="@string/todo"
                        android:text="@string/_4_min_ago"
                        android:textColor="@color/text_color_dark"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_trip_three"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:layout_width="35sp"
                        android:layout_height="35sp"
                        android:layout_gravity="center|start"
                        android:layout_margin="5dp"
                        android:background="@drawable/ic_circle_color_gray"
                        android:backgroundTint="@color/white"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="35sp"
                        android:layout_height="35sp"
                        android:layout_margin="5dp"
                        android:layout_weight="0.0"
                        android:background="@drawable/ic_circle_color_gray"
                        android:backgroundTint="@color/white"
                        android:contentDescription="@string/todo"
                        android:padding="10dp"
                        android:src="@drawable/ic_greendot"
                        android:visibility="gone"
                        app:tint="@color/colorPrimary" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_accept_three"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:gravity="center|start"
                            android:text="@string/map_status_count_Driver_has_arrived_to_job_location"
                            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                            android:textColor="@color/black" />

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_accept_time_three"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/txt_accept_three"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:gravity="center|start"
                            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                            android:textColor="@color/white" />

                    </RelativeLayout>

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_min_ago_three"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="0.0"
                        android:contentDescription="@string/todo"
                        android:text="@string/_4_min_ago"
                        android:textColor="@color/text_color_dark"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_trip_four"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:layout_width="35sp"
                        android:layout_height="35sp"
                        android:layout_gravity="center|start"
                        android:layout_margin="5dp"
                        android:background="@drawable/ic_circle_color_gray"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="35sp"
                        android:layout_height="35sp"
                        android:layout_margin="5dp"
                        android:layout_weight="0.0"
                        android:background="@drawable/ic_circle_color_gray"
                        android:backgroundTint="@color/white"
                        android:contentDescription="@string/todo"
                        android:padding="10dp"
                        android:src="@drawable/ic_greendot"
                        android:visibility="gone" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_accept_four"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:gravity="center|start"
                            android:text="@string/map_status_count_Driver_has_started_job"
                            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                            android:textColor="@color/black" />

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_accept_time_four"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/txt_accept_four"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:gravity="center|start"
                            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                            android:textColor="@color/white" />

                    </RelativeLayout>

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_min_ago_four"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="0.0"
                        android:contentDescription="@string/todo"
                        android:text="@string/_4_min_ago"
                        android:textColor="@color/text_color_dark"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_trip_five"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:layout_width="35sp"
                        android:layout_height="35sp"
                        android:layout_gravity="center|start"
                        android:layout_margin="5dp"
                        android:background="@drawable/ic_circle_color_gray"
                        android:backgroundTint="@android:color/holo_red_dark"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="38sp"
                        android:layout_height="38sp"
                        android:layout_margin="5dp"
                        android:layout_weight="0.0"
                        android:background="@drawable/ic_circle_color_gray"
                        android:backgroundTint="@color/white"
                        android:contentDescription="@string/todo"
                        android:padding="12dp"
                        android:src="@drawable/ic_greendot"
                        android:visibility="gone"
                        app:tint="@android:color/holo_red_dark" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_accept_five"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:gravity="center|start"
                            android:text="@string/guard_completed_your_job"
                            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                            android:textColor="@color/black" />

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_accept_time_five"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/txt_accept_five"
                            android:layout_gravity="center"
                            android:layout_marginStart="5dp"
                            android:gravity="center|start"
                            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                            android:textColor="@color/holo_red_dark"
                            android:visibility="gone" />

                    </RelativeLayout>

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_min_ago_five"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="0.0"
                        android:contentDescription="@string/todo"
                        android:text="@string/_4_min_ago"
                        android:textColor="@color/text_color_dark"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </com.instaguard.provider.Helpers.ExpansionPanelLayout.ExpansionLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_break_pt_job_inprogress"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="-1.0dip"
        android:layout_marginEnd="5dp"
        android:contentDescription="@string/todo"
        android:scaleType="fitXY"
        android:src="@drawable/bottom_strip_repeat"
        android:visibility="gone"
        app:tint="#ffe4e4e4" />


</LinearLayout>
