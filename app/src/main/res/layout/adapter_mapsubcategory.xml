<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:visibility="visible"
        android:id="@+id/rl_category_name"
        android:layout_marginStart="8dp"
        tools:ignore="UselessParent">

        <ImageView
            android:id="@+id/img_category1"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_centerHorizontal="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:visibility="gone"
            android:layout_marginBottom="5dp"
            android:contentDescription="@string/todo" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:visibility="gone"
            android:layout_marginTop="5dp"
            android:contentDescription="@string/todo" />

        <ImageView
            android:id="@+id/img_category_bg"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_alignParentStart="true"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:contentDescription="@string/todo" />

        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/img_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@+id/img_category_bg"
            android:layout_alignTop="@+id/img_category_bg"
            android:layout_alignEnd="@+id/img_category_bg"
            android:layout_alignBottom="@+id/img_category_bg"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:layout_margin="2dp"
            android:padding="5dp"
            android:scaleType="fitXY"
            app:actualImageScaleType="none"
            app:failureImage="@drawable/ic_hatchback"
            app:placeholderImage="@drawable/ic_hatchback" />

        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/chk_sub_category"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@+id/img_category_bg"
            android:layout_alignBottom="@+id/img_category_bg"/>

        <com.instaguard.provider.CustomViews.CustomTextView
            android:id="@+id/txt_category_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foregroundGravity="center"
            android:layout_alignTop="@+id/img_category"
            android:layout_alignBottom="@+id/img_category"
            android:layout_toEndOf="@+id/img_category_bg"
            android:layout_toStartOf="@+id/chk_sub_category"
            android:gravity="center|start"
            android:textAlignment="viewStart"
            android:text="@string/category_name"
            android:textSize="16sp"
            android:singleLine="true"
            android:textColor="#000" />


        <ImageView
            android:id="@+id/img_rightarrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:foregroundGravity="center"
            android:layout_centerInParent="true"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:visibility="gone"
            android:src="@drawable/ic_right_arrow_black"
            android:layout_marginBottom="5dp"
            android:contentDescription="@string/todo" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@+id/rl_category_name"
        android:background="#ffefefef" />
