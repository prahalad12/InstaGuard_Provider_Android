<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10sp"
        android:background="@drawable/bg_rect_border_cp_elevation"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="2sp"
        app:cardElevation="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0dp"
            android:padding="5dp"
            android:id="@+id/rl_top_offer_lyt"
            android:background="@drawable/bg_rect_border_cp_elevation">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="5dp"
                android:background="@drawable/ic_circle_color_gray"
                android:padding="15dp"
                android:src="@drawable/ic_offers"
                android:id="@+id/img_offers"
                android:contentDescription="@string/todo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignTop="@+id/img_offers"
                android:layout_alignBottom="@+id/img_offers"
                android:layout_toEndOf="@+id/img_offers">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/app_name_toolbar"
                    android:textSize="16sp"
                    android:textAlignment="viewStart"
                    android:layout_gravity="center"
                    android:gravity="center|start"
                    android:textColor="@color/black"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:id="@+id/txt_title"/>

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/app_name_toolbar"
                    android:textSize="13sp"
                    android:textAlignment="viewStart"
                    android:layout_gravity="center"
                    android:gravity="center|start"
                    android:textColor="@color/black"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:id="@+id/txt_date"/>

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/app_name"
                    android:layout_marginTop="5dp"
                    android:textAlignment="viewStart"
                    android:textSize="14sp"
                    android:layout_gravity="center"
                    android:gravity="start"
                    android:maxLines="2"
                    android:textColor="@color/black"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:id="@+id/txt_message"/>

            </LinearLayout>


        </RelativeLayout>


    </androidx.cardview.widget.CardView>


</RelativeLayout>


