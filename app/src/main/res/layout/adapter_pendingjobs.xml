<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="#fff5f5f5"
    android:id="@+id/ll_pastjobs_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5.0dip"
        android:layout_marginEnd="10.0dip"
        android:layout_marginStart="10.0dip"
        android:layout_marginTop="10.0dip"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:layout_weight="1.0"
            android:orientation="horizontal">

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/txt_bookingno_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:gravity="start|center"
                android:maxLines="1"
                android:text="@string/ongoingjobs_booking_no_label"
                android:textColor="#ff0f0f0f"
                android:textSize="16dp"
                android:textStyle="normal" />

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/txt_bookingid"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:layout_marginStart="3.0dip"
                android:gravity="start|center"
                android:maxLines="1"
                android:text="#"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="16dp"
                android:textStyle="normal" />
        </LinearLayout>

        <com.instaguard.provider.CustomViews.CustomTextView
            android:id="@+id/txt_bookingdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center"
            android:layout_marginStart="5.0dip"
            android:layout_marginTop="4.0dip"
            android:gravity="start|center"
            android:maxLines="1"
            android:text="17th sep at 9:00 PM"
            android:textColor="#ffc1c1c1"
            android:textSize="14dp"
            android:textStyle="normal"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5.0dip"
        android:background="#fff5f5f5"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="5.0dip"
        app:cardElevation="3.0dip"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:id="@+id/contentArea"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_deliverdetails"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:background="#ffffffff"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:orientation="horizontal">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_booking_date"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:layout_marginEnd="10.0dip"
                        android:layout_marginStart="3.0dip"
                        android:gravity="end|center"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="#ff0f0f0f"
                        android:textSize="16dp"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:layout_weight="1.0"
                    android:orientation="horizontal">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_booking_category"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:layout_marginEnd="10.0dip"
                        android:layout_marginStart="3.0dip"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="16dp"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5.0dip"
                    android:layout_marginEnd="10.0dip"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginTop="5.0dip"
                    android:gravity="start|center|top"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:padding="1.0dip"
                        android:src="@drawable/ic_greendot"
                        android:visibility="visible"
                        android:contentDescription="@string/todo" />


                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/img_booking_driver"
                        android:layout_width="80.0dip"
                        android:layout_height="80.0dip"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        />

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10.0dip"
                        android:orientation="vertical">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_job_location_label"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center|top"
                            android:layout_marginStart="5.0dip"
                            android:gravity="start|center"
                            android:maxLines="1"
                            android:text="@string/job_location"
                            android:textColor="@color/black"
                            android:textSize="15dp"
                            android:textStyle="bold" />

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_job_location"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center"
                            android:layout_marginStart="5.0dip"
                            android:gravity="start|center"
                            android:text="@string/pickup_address"
                            android:textColor="#ff1e1e1e"
                            android:textSize="14dp"
                            android:textStyle="normal" />
                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_agent_count"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/txt_Driver_ph_label"
                            android:layout_gravity="start|center|top"
                            android:layout_marginStart="5.0dip"
                            android:layout_marginTop="5.0dip"
                            android:layout_toStartOf="@+id/ll_call_msg_lyt"
                            android:gravity="start|center"
                            android:hint="Company Name :- 9876543210"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:textSize="13sp" />
                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_agent_days"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/txt_Driver_ph_label"
                            android:layout_gravity="start|center|top"
                            android:layout_marginStart="5.0dip"
                            android:layout_marginTop="5.0dip"
                            android:layout_toStartOf="@+id/ll_call_msg_lyt"
                            android:gravity="start|center"
                            android:hint="Company Name :- 9876543210"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1dip"
                    android:background="#ffcecece"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:visibility="visible" />

                <LinearLayout
                    android:id="@+id/ll_status"
                    android:layout_width="fill_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:layout_margin="5.0dip"
                    android:weightSum="2"
                    android:orientation="horizontal">

                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_acceptjobs_pending"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:background="@drawable/bg_rect_filled_colorprimary"
                        android:layout_weight="1"
                        android:textColor="@color/white"
                        android:layout_margin="5dp"
                        android:text="@string/pending_jobs_accept_job"/>
                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_declinejobs_pending"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_rect_filled_colorprimary"
                        android:text="@string/pending_jobs_decline_job"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>