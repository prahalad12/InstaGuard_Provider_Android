<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10sp"
        app:cardCornerRadius="4dp"
        app:cardElevation="5dp">

        <RelativeLayout
            android:id="@+id/rl_top_subs_plan_lyt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/lorder_id"
                android:layout_toStartOf="@+id/img_check"
                android:orientation="horizontal">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_orderId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:gravity="center|start"
                    android:hint="Order Id:- "
                    android:padding="5dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_disable_auto_renew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="5dp"
                    android:gravity="center|end"
                    android:layout_weight="1"
                    android:text="@string/disable_autorenew"
                    android:visibility="gone"
                    android:padding="5dp"
                    android:textAlignment="viewEnd"
                    android:textColor="@android:color/holo_red_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <ImageView
                android:id="@+id/img_offers"
                android:layout_width="5dp"
                android:layout_height="45dp"
                android:layout_below="@+id/lorder_id"
                android:layout_alignParentStart="true"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/ic_circle_color_gray"
                android:backgroundTint="@color/black"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:src="@drawable/ic_round_local_offer_24"
                android:visibility="gone"
                app:tint="@color/colorPrimary" />

            <LinearLayout
                android:id="@+id/ll_parent_lyt_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lorder_id"
                android:layout_alignTop="@+id/img_offers"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/img_check"
                android:layout_toEndOf="@+id/img_offers"
                android:orientation="vertical"
                android:paddingStart="5dp">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center|start"
                    android:hint="--"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_plan_period"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:gravity="center|start"
                    android:hint="--"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:gravity="center|start"
                    android:hint="--"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_date_expiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:gravity="center|start"
                    android:hint="--"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_message"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="3dp"
                        android:gravity="start"
                        android:hint="--"
                        android:maxLines="2"
                        android:layout_weight="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_active_expire"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="3dp"
                        android:layout_weight="1"
                        android:gravity="end|center"
                        android:hint="--"
                        android:maxLines="2"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/holo_red_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/txt_more_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_parent_lyt_view"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:drawableEnd="@drawable/ic_chevron_right_black_small"
                android:gravity="center|end"
                android:maxLines="2"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/more_info"
                android:textAlignment="viewEnd"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="normal"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/img_check"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_alignParentEnd="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="5dp"
                android:contentDescription="@string/todo"
                android:padding="5dp"
                android:src="@drawable/ic_baseline_check_circle_24"
                android:visibility="gone"
                app:tint="@color/gray_light" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>


