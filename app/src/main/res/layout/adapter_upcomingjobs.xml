<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_pastjobs_parent"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="#fff5f5f5"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginEnd="10.0dip"
        android:layout_marginBottom="5.0dip"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:layout_weight="1.0"
            android:orientation="horizontal">

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/txt_bookingno_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:gravity="start|center"
                android:maxLines="1"
                android:text="@string/ongoingjobs_booking_no_label"
                android:textColor="#ff0f0f0f"
                android:textSize="16dp"
                android:textStyle="normal" />

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/txt_bookingid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:layout_marginStart="3.0dip"
                android:gravity="start|center"
                android:maxLines="1"
                android:text="#"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="16dp"
                android:textStyle="normal" />

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/txt_total_fare"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:layout_marginStart="3.0dip"
                android:gravity="end|center"
                android:maxLines="1"
                android:visibility="gone"
                android:text="# 120"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="16dp"
                android:textStyle="normal" />

        </LinearLayout>

        <com.instaguard.provider.CustomViews.CustomTextView
            android:id="@+id/txt_bookingdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center"
            android:layout_marginStart="5.0dip"
            android:layout_marginTop="4.0dip"
            android:gravity="start|center"
            android:maxLines="1"
            android:text="17th sep at 9:00 PM"
            android:textColor="#ffc1c1c1"
            android:textSize="14dp"
            android:textStyle="normal"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5.0dip"
        android:background="#fff5f5f5"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="5.0dip"
        app:cardElevation="3.0dip"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:id="@+id/contentArea"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_deliverdetails"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:background="#ffffffff"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_booking_date"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:layout_marginStart="3.0dip"
                        android:layout_marginEnd="10.0dip"
                        android:gravity="end|center"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="#ff0f0f0f"
                        android:textSize="16dp"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:layout_weight="1.0"
                    android:orientation="horizontal">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_booking_category"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:layout_marginStart="3.0dip"
                        android:layout_marginEnd="10.0dip"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="16dp"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginTop="5.0dip"
                    android:layout_marginEnd="10.0dip"
                    android:layout_marginBottom="5.0dip"
                    android:gravity="start|center|top"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/todo"
                        android:padding="1.0dip"
                        android:src="@drawable/ic_greendot"
                        android:visibility="visible" />

                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/img_booking_driver"
                        android:layout_width="80.0dip"
                        android:layout_height="80.0dip"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10.0dip"
                        android:orientation="vertical">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_job_location_label"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center|top"
                            android:layout_marginStart="5.0dip"
                            android:gravity="start|center"
                            android:maxLines="1"
                            android:text="@string/job_location"
                            android:textColor="@color/black"
                            android:textSize="15dp"
                            android:textStyle="bold" />

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_job_location"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center"
                            android:layout_marginStart="5.0dip"
                            android:gravity="start|center"
                            android:text="@string/pickup_address"
                            android:textColor="#ff1e1e1e"
                            android:textSize="14dp"
                            android:textStyle="normal" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dip"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="#ffcecece"
                    android:visibility="visible" />

                <TableRow
                    android:id="@+id/tr_start_date_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="5dp"
                    android:gravity="center"
                    android:visibility="visible">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_start_date_time_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5.0dip"
                        android:layout_weight="1"
                        android:gravity="center|start"
                        android:text="@string/start_date_time"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_start_date_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5.0dip"
                        android:layout_weight="1"
                        android:gravity="center|end"
                        android:text="@string/start_date_time"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="14sp" />

                </TableRow>

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dip"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="#ffcecece"
                    android:visibility="visible" />

                <TableRow
                    android:id="@+id/tr_end_date_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:gravity="center"
                    android:visibility="visible">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_end_date_time_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5.0dip"
                        android:layout_weight="1"
                        android:gravity="center|start"
                        android:text="@string/end_date_time"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_end_date_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="5.0dip"
                        android:layout_weight="1"
                        android:gravity="center|end"
                        android:text="@string/end_date_time"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="14sp" />

                </TableRow>

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dip"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="#ffcecece"
                    android:visibility="visible" />

                <RelativeLayout
                    android:id="@+id/rl_parent_lyt_provider_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7.5dip"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="8.0dip"
                    android:layout_marginBottom="7.5dip"
                    android:visibility="visible">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_Driver_info_label"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center|top"
                        android:layout_marginStart="5.0dip"
                        android:layout_marginTop="5.0dip"
                        android:gravity="center|start"
                        android:maxLines="1"
                        android:text="@string/customer_details"
                        android:textColor="@color/grey_80"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/ll_call_msg_lyt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txt_Driver_info_label"
                        android:layout_alignParentEnd="true"
                        android:gravity="center|end"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/img_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center|start"
                            android:layout_margin="3dp"
                            android:background="@drawable/ic_circle_color_gray"
                            android:contentDescription="@string/todo"
                            android:padding="3dp"
                            android:src="@drawable/ic_baseline_phone_24" />

                        <ImageButton
                            android:id="@+id/img_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center|end"
                            android:layout_margin="3dp"
                            android:background="@drawable/ic_circle_color_gray"
                            android:contentDescription="@string/todo"
                            android:padding="3dp"
                            android:src="@drawable/ic_baseline_message_24" />

                    </LinearLayout>

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_Driver_name_label"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txt_Driver_info_label"
                        android:layout_gravity="start|center|top"
                        android:layout_marginStart="5.0dip"
                        android:layout_marginTop="5.0dip"
                        android:layout_toStartOf="@+id/ll_call_msg_lyt"
                        android:gravity="start|center"
                        android:hint="Name :- Vigsa"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/grey_80"
                        android:textSize="13sp" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_startdatetime_label"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txt_Driver_name_label"
                        android:layout_gravity="start|center|top"
                        android:layout_marginStart="5.0dip"
                        android:layout_marginTop="5.0dip"
                        android:layout_toStartOf="@+id/ll_call_msg_lyt"
                        android:gravity="start|center"
                        android:hint="StartDateTime :- Vigsa"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/grey_80"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_enddatetime_label"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txt_startdatetime_label"
                        android:layout_gravity="start|center|top"
                        android:layout_marginStart="5.0dip"
                        android:layout_marginTop="5.0dip"
                        android:layout_toStartOf="@+id/ll_call_msg_lyt"
                        android:gravity="start|center"
                        android:hint="StartDateTime :- Vigsa"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/grey_80"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_Driver_ph_label"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txt_Driver_name_label"
                        android:layout_gravity="start|center|top"
                        android:layout_marginStart="5.0dip"
                        android:layout_marginTop="5.0dip"
                        android:layout_toStartOf="@+id/ll_call_msg_lyt"
                        android:gravity="start|center"
                        android:hint="Phone :- 9876543210"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/grey_80"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_agent_count"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txt_Driver_ph_label"
                        android:layout_gravity="start|center|top"
                        android:layout_marginStart="5.0dip"
                        android:layout_marginTop="5.0dip"
                        android:layout_toStartOf="@+id/ll_call_msg_lyt"
                        android:gravity="start|center"
                        android:hint="Company Name :- 9876543210"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_agent_days"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txt_agent_count"
                        android:layout_gravity="start|center|top"
                        android:layout_marginStart="5.0dip"
                        android:layout_marginTop="5.0dip"
                        android:layout_toStartOf="@+id/ll_call_msg_lyt"
                        android:gravity="start|center"
                        android:hint="Company Name :- 9876543210"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </RelativeLayout>

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="0.5dip"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="#ffcecece"
                    android:visibility="visible" />

                <LinearLayout
                    android:id="@+id/ll_status_btnjob"
                    android:layout_width="fill_parent"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_startjobs_upcoming"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rect_filled_colorprimary"
                        android:text="@string/upcoming_jobs_start_job"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_canceljobs_upcoming"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rect_filled_colorprimary"
                        android:backgroundTint="@android:color/holo_red_dark"
                        android:text="@string/upcoming_jobs_cancel_job"
                        android:visibility="gone"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_transferjobs_upcoming"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rect_filled_colorprimary"
                        android:backgroundTint="@color/colorPrimaryDark"
                        android:text="@string/transfer_job"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/ll_status"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_upcoming"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@color/colorPrimary"
                        android:visibility="gone" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_status_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:text="@string/status"
                        android:textAlignment="center"
                        android:textColor="@android:color/holo_blue_bright"
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:visibility="visible" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center"
                        android:layout_marginStart="5.0dip"
                        android:text="@string/upcoming_job_finished"
                        android:textAlignment="center"
                        android:textColor="@android:color/holo_green_dark"
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:visibility="visible" />


                </LinearLayout>


            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>