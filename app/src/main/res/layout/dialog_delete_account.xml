<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_curve_filled_black_outline_white"
    android:backgroundTint="@color/transparent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center">

        <RelativeLayout
            android:id="@+id/relativeLayoutTransparent"
            android:layout_width="match_parent"
            android:layout_height="40dp">

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relativeLayoutDialogRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/relativeLayoutTransparent"
            android:background="@drawable/bg_curve_filled_black_outline_white"
            android:backgroundTint="@color/white"
            android:minHeight="260dp">

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/linearLayoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_accept"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/ic_circle_elevation_white"
                android:backgroundTint="@color/colorPrimary"
                android:padding="15dp"
                android:src="@drawable/ic_baseline_delete_24"
                app:tint="@color/white" />

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/txt_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/delete_account"
                android:textColor="@color/black"
                android:layout_marginTop="18dp"
                android:textSize="25dp"
                android:visibility="visible" />


            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/txt_description_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:gravity="center_horizontal"
                android:text=""
                android:textColor="@color/black"
                android:textSize="18dp"
                android:visibility="visible" />



            <RelativeLayout
                android:id="@+id/success"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_description"
                android:layout_centerInParent="true"
                android:layout_margin="0dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_curve_filled_black_outline_white"
                android:backgroundTint="@color/white"
                android:visibility="visible">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="0dp"
                    android:background="@null"
                    android:gravity="end"
                    android:padding="12dp"
                    android:layout_marginEnd="20dp"
                    android:text="@string/no"
                    android:layout_toStartOf="@+id/txt_okay"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:textAllCaps="true"
                    android:visibility="visible" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_okay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="end"
                    android:padding="10dp"
                    android:text="@string/yes"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:visibility="visible" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
