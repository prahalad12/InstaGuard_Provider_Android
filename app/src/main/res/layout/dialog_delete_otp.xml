<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_curve_filled_black_outline_white"
    android:backgroundTint="@color/transparent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center">

        <RelativeLayout
            android:id="@+id/relativeLayoutTransparent"
            android:layout_width="match_parent"
            android:layout_height="40dp">

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relativeLayoutDialogRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/relativeLayoutTransparent"
            android:background="@drawable/bg_curve_filled_black_outline_white"
            android:backgroundTint="@color/white"
            android:minHeight="420dp">

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/linearLayoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_menu_profile"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/ic_circle_elevation_white"
                android:backgroundTint="@color/colorPrimary"
                android:padding="15dp"
                android:src="@drawable/ic_baseline_verified_user_24"
                app:tint="@color/white" />

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/txt_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center_horizontal"
                android:text="@string/verify_otp"
                android:textColor="@color/black"
                android:textSize="25dp"
                android:visibility="visible" />


            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/txt_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_header"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:gravity="center_horizontal"
                android:text="@string/account_verification_we_hav_content"
                android:textColor="@color/black"
                android:textSize="18dp"
                android:visibility="visible" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="15dp"
                android:visibility="visible">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_mobileview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:drawableStart="@drawable/ic_baseline_email_24"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/black"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="@string/account_verification_email_sent_to_text"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                    android:textColor="@color/black"
                    tools:targetApi="m" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_mobilenum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_toEndOf="@+id/txt_mobileview"
                    android:gravity="center|start"
                    android:text="sikkantar"
                    android:maxLines="3"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
                    android:textColor="@color/black" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlotppage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="visible">

                <com.chaos.view.PinView
                    android:id="@+id/edt_otp"
                    style="@style/PinWidget.PinView"
                    android:layout_width="wrap_content"
                    android:layout_height="55dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="25dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="25dp"
                    android:layout_marginBottom="15dp"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:padding="1dp"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cursorColor="@color/colorPrimary"
                    app:itemCount="4"
                    app:itemHeight="50dp"
                    app:itemRadius="4dp"
                    app:itemSpacing="7dp"
                    app:itemWidth="50dp"
                    app:lineColor="@color/colorPrimary" />


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/edt_otp"
                    android:layout_margin="0dp"
                    android:orientation="horizontal">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_resendotp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="5dp"
                        android:foregroundGravity="center"
                        android:gravity="end"
                        android:padding="5dp"
                        android:text="@string/account_verification_resend_email_text"
                        android:textAllCaps="true"
                        android:textColor="@color/colorPrimary"
                        tools:ignore="MissingPrefix,RelativeOverlap,RtlHardcoded" />


                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_below="@+id/txt_resendotp"
                        android:background="@color/black"
                        android:visibility="visible" />


                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="80dp"
                        android:layout_below="@+id/view"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center"

                        android:gravity="center"
                        app:cardBackgroundColor="@color/colorPrimary"
                        app:cardCornerRadius="5dp"
                        app:cardElevation="5dp"
                        app:cardMaxElevation="8dp"
                        app:cardPreventCornerOverlap="true"
                        app:cardUseCompatPadding="true">

                        <com.instaguard.provider.CustomViews.CustomButton
                            android:id="@+id/btn_confirmsignupotp"
                            android:layout_width="wrap_content"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="15dp"
                            android:layout_marginEnd="15dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:gravity="center"
                            android:text="@string/account_verification_submit_text"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </androidx.cardview.widget.CardView>

                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
