<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.instaguard.provider.CustomViews.CustomTextView
            android:id="@+id/txt_select_currency"
            style="@style/AppThemeToolBarCenter"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_toolbar_gradient"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/document_info"
            android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
            android:textSize="16sp" />

        <ImageView
            style="@style/AppThemeToolBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:contentDescription="@string/todo"
            android:foregroundGravity="center"
            android:padding="7dp"
            android:src="@drawable/ic_close_black"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/txt_select_currency"
            android:background="@android:color/white" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/rcv_currency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/btn_confirm_document_upload"
            android:layout_below="@+id/txt_select_currency"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:background="@color/white"
            android:padding="8dp"
            android:visibility="visible">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_select_"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="@string/document_info"
                    android:textSize="14sp" />

            </RelativeLayout>

        </androidx.core.widget.NestedScrollView>

        <com.instaguard.provider.CustomViews.CustomButton
            android:id="@+id/btn_confirm_document_upload"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_rect_filled_colorprimary"
            android:gravity="center"
            android:text="@string/agree"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="12sp" />

    </RelativeLayout>

</RelativeLayout>