<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBlacktransperant"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6" />

    <RelativeLayout
        android:id="@+id/rl_parent_lyt_request"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="5dp"
        android:layout_weight="1.4"
        android:background="@drawable/bg_rect_filled_colorprimary"
        android:backgroundTint="@color/white">

        <RelativeLayout
            android:id="@+id/top_toolbar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_toolbar_gradient">

            <com.instaguard.provider.CustomViews.CustomTextView
                style="@style/AppThemeToolBarCenter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:text="@string/sos_backup_requesting"
                android:textAllCaps="true"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/reqRelView_request"
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/top_toolbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_toolbar">

            <com.skyfishjy.library.RippleBackground
                android:id="@+id/rippleBackground"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_centerInParent="true"
                app:rb_color="@color/colorPrimaryDark"
                app:rb_duration="3000"
                app:rb_radius="32.0dip"
                app:rb_rippleAmount="4"
                app:rb_scale="6.0">

                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">

                    <ImageView
                        android:layout_width="100.0dip"
                        android:layout_height="100.0dip"
                        android:layout_centerInParent="true"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/ic_circle_color"
                        app:tint="@color/white" />

                    <ImageView
                        android:layout_width="90.0dip"
                        android:layout_height="90.0dip"
                        android:layout_centerInParent="true"
                        android:contentDescription="@string/todo"
                        android:src="@drawable/logo" />

                </RelativeLayout>

            </com.skyfishjy.library.RippleBackground>

            <RelativeLayout
                android:id="@+id/rl_timer_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="20.0dip">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_count_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_margin="15dp"
                    android:gravity="center"
                    android:hint="00.00"
                    android:padding="5dp"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:layout_centerInParent="true"
                    android:background="@android:color/transparent"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_cancelrequest"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/todo"
                    android:visibility="gone"
                    app:tint="@android:color/holo_red_dark" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/btn_cancel_request"
                    android:layout_width="120dp"
                    android:layout_height="35dp"
                    android:layout_below="@+id/txt_count_timer"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_rect_filled_colorprimary"
                    android:backgroundTint="@android:color/holo_red_dark"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="5dp"
                    android:text="@string/cancel"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:visibility="invisible"
                    tools:ignore="RelativeOverlap" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/ll_parent_lyt_backup_guard_accepted"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:clickable="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:gravity="center"
                    android:text="@string/backup_required_requested_guard_accepted"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="normal" />

                <com.instaguard.provider.CustomViews.CustomButton
                    android:id="@+id/btn_okay_backup_guard_accepted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_rect_filled_colorprimary"
                    android:padding="3dp"
                    android:text="@string/ok"
                    android:textColor="@color/white" />

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>

</LinearLayout>