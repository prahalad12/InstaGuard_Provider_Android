<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/rl_parent_lyt_subs_details_view"
        android:layout_centerInParent="true"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="@color/bg_gray_common"
            android:orientation="vertical">

            <android.widget.Toolbar
                android:id="@+id/toolbar_scbs_plan"
                android:layout_width="match_parent"
                android:layout_height="?android:attr/actionBarSize"
                android:layout_alignParentTop="true"
                android:background="@drawable/bg_toolbar_gradient">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageButton
                        android:id="@+id/imgbtn_back_details_view"
                        style="@style/AppThemeToolBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_back_whitearrow"
                        tools:ignore="ContentDescription" />

                    <ImageButton
                        android:id="@+id/imgbtn_backs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_chevron_left_black"
                        android:visibility="invisible"
                        tools:ignore="ContentDescription" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_scbs_plan_header"
                        style="@style/AppThemeToolBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/imgbtn_backs"
                        android:layout_alignBottom="@+id/imgbtn_backs"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="40dp"
                        android:layout_toStartOf="@+id/imgbtn_backs"
                        android:layout_toEndOf="@+id/imgbtn_back_details_view"
                        android:text="@string/nav_mymembership"
                        android:textAllCaps="true"

                        tools:ignore="MissingPrefix,RtlHardcoded" />

                </RelativeLayout>

            </android.widget.Toolbar>

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/toolbar"
                android:layout_margin="0dp"
                android:background="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_plan_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@color/colorPrimary"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="Book Home Appoinment Plan"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:visibility="gone"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.2dp"
                        android:background="@color/gray_light" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_remaining"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="0dp"
                        android:layout_weight="1"
                        android:background="@color/holo_red_dark"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="Remaining 1 Free Job Request"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_title_dialog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="15dp"
                        android:text="Roadside Plan"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.2dp"
                        android:background="@color/gray_light" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:orientation="horizontal">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_period_type"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center|start"
                            android:padding="5dp"
                            android:text="Monthly"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_amount"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:gravity="center|end"
                            android:padding="5dp"
                            android:text="CAD 89.99"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.2dp"
                        android:background="@color/gray_light" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_free_km"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center|start"
                            android:padding="5dp"
                            android:text="30 Free KM"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:visibility="visible" />

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_free_trips"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:layout_weight="1"
                            android:gravity="center|end"
                            android:padding="5dp"
                            android:text="3 Free Job Request"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.2dp"
                        android:background="@color/gray_light" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_descriptio_lablen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:gravity="center|start"
                        android:paddingStart="10dp"
                        android:text="@string/description"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:gravity="center|start"
                        android:padding="10dp"
                        android:text="@string/description"
                        android:textColor="@color/black"
                        android:textSize="20sp" />

                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_continue_subscr_plan_details_view"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_rect_cp_curve_plan"
                        android:contentDescription="@string/todo"
                        android:text="@string/buy_plan"
                        android:textColor="@color/white"
                        android:visibility="visible" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>








