<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        app:cardMaxElevation="8sp"
        app:cardBackgroundColor="@color/white"
        android:layout_centerInParent="true"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        app:cardCornerRadius="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2sp"
            android:layout_centerInParent="true">

        <!--    <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_close_white"
                android:foregroundGravity="center"
                android:padding="7dp"
                android:id="@+id/iv_close_toast"
                android:visibility="visible"
                android:layout_alignParentEnd="true"
                android:contentDescription="@string/todo"
                app:tint="@color/black" />

            <com.instaguard.provider.CustomViews.CustomTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                android:padding="10dp"
                android:textAllCaps="true"
                android:visibility="visible"
                android:id="@+id/txt_select_currency"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:gravity="center" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.4dp"
                android:layout_marginBottom="5dp"
                android:id="@+id/view"
                android:visibility="visible"
                android:layout_below="@+id/txt_select_currency"
                android:background="@color/black" />-->

            <com.instaguard.provider.CustomViews.CustomTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/just_for_your_information"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_gravity="center"
                android:textSize="18sp"
                android:id="@+id/txtin"
                android:textColor="@color/black"
                android:gravity="center" />

            <com.instaguard.provider.CustomViews.CustomTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_gravity="center"
                android:textSize="16sp"
                android:id="@+id/txt_msg"
                android:layout_below="@+id/txtin"
                android:textColor="@color/black"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="3"
                android:visibility="visible"
                android:layout_marginBottom="10sp"
                android:layout_below="@+id/txt_msg">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:textColor="@color/black"
                    android:text="@string/yes"
                    android:gravity="center"
                    android:id="@+id/btn_o"
                    android:layout_weight="1"
                    android:textSize="12dp"
                    android:visibility="invisible"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="0sp" />
                <com.instaguard.provider.CustomViews.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:textColor="@color/black"
                    android:text="@string/yes"
                    android:gravity="center"
                    android:id="@+id/bt_o"
                    android:layout_weight="1"
                    android:textSize="12dp"
                    android:visibility="invisible"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="0sp" />

                <com.instaguard.provider.CustomViews.CustomButton
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:textColor="@color/colorPrimary"
                    android:text="@string/ok"
                    android:gravity="center"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:id="@+id/btn_okay"
                    android:layout_marginTop="0sp"
                    android:layout_marginBottom="0sp"
                    android:background="@null" />

            </LinearLayout>


        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>