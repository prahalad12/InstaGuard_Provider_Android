<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/ll_parennt_earnings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_setting"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@drawable/bg_toolbar_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/imgbtn_back"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:contentDescription="@string/todo"
                    android:padding="10dp"
                    android:src="@drawable/ic_back_whitearrow" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/textView"
                    style="@style/AppThemeToolBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/imgbtn_back"
                    android:layout_alignBottom="@+id/imgbtn_back"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="0dp"
                    android:layout_toStartOf="@+id/iv_menu_profile"
                    android:layout_toEndOf="@+id/imgbtn_back"
                    android:foregroundGravity="center"
                    android:gravity="center|start"
                    android:text="@string/earnings_title"
                    android:textAllCaps="true"
                    android:textSize="18sp"
                    tools:ignore="MissingPrefix" />

                <ImageView
                    android:id="@+id/iv_menu_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="@string/todo"
                    android:padding="10dp"
                    style="@style/AppThemeToolBar"
                    android:src="@drawable/ic_refresh_black_24dp"
                    android:visibility="visible"
                    tools:ignore="RtlHardcoded" />

            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_earnings"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-2dp"
                        android:background="@drawable/bg_toolbar_gradient_bottom_top"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="10.0dip"
                            android:layout_marginTop="20.0dip"
                            android:layout_marginEnd="10.0dip"
                            android:layout_marginBottom="5.0dip"
                            android:gravity="center_vertical"
                            android:orientation="vertical">


                            <com.instaguard.provider.CustomViews.CustomTextView
                                android:id="@+id/txt_total_earnings_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginEnd="10dp"
                                android:foregroundGravity="center"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/total_earnings"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/toolbar_setting" />

                            <com.instaguard.provider.CustomViews.CustomTextView
                                android:id="@+id/txt_total_earnings"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="10dp"
                                android:foregroundGravity="center"
                                android:gravity="center"
                                android:hint="-"
                                android:padding="5dp"
                                android:textColor="@color/white"
                                android:textColorHint="@color/white"
                                android:textSize="45sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/txt_total_earnings_label" />


                        </LinearLayout>


                        <com.instaguard.provider.CustomViews.CustomButton
                            android:id="@+id/btn_viewtransactions"
                            android:layout_width="fill_parent"
                            android:layout_height="45sp"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="25.0dip"
                            android:layout_marginEnd="25.0dip"
                            android:background="@drawable/bg_rect_filled_colorprimary"
                            android:text="@string/my_wallet_view_transactions_btn_text"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:visibility="gone" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0.1dp"
                        android:background="@android:color/transparent"
                        android:foreground="@drawable/bottom_shadow"
                        android:orientation="vertical"
                        tools:targetApi="m">

                        <ProgressBar
                            android:id="@+id/progress_indeterminate_determinate"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/black"
                            android:max="100"
                            android:progress="20"
                            android:progressTint="@color/black"
                            android:visibility="invisible" />


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.4dp"
                            android:layout_margin="8dp"
                            android:background="@color/black"
                            android:visibility="gone"

                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/txt_total_earnings" />

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">


                            <TableRow
                                android:id="@+id/tr_total_cash_payment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="10.0dip"
                                android:padding="3dp">

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_total_cash_payment_amount_label"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center"
                                    android:layout_weight="1.2"
                                    android:gravity="start"
                                    android:padding="5dp"
                                    android:text="@string/total_cash_payment_amount"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="normal" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center"
                                    android:gravity="center"
                                    android:padding="5dp"
                                    android:text=":"
                                    android:textColor="@color/black"
                                    android:textSize="14dp"
                                    android:textStyle="normal" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_total_cash_payment_amount"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end|center"
                                    android:layout_weight="0.8"
                                    android:gravity="end"
                                    android:hint="--"
                                    android:padding="5dp"
                                    android:textAlignment="textEnd"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </TableRow>


                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.4dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:background="@color/black"
                                android:visibility="gone"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/txt_total_earnings" />

                            <TableRow
                                android:id="@+id/tr_total_card_payment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10.0dip"
                                android:layout_marginTop="5.0dip"
                                android:layout_marginEnd="10.0dip"
                                android:layout_marginBottom="10.0dip"
                                android:padding="3dp"
                                android:visibility="gone">

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_total_card_payment_amount_label"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center"
                                    android:layout_weight="1.2"
                                    android:gravity="start"
                                    android:padding="5dp"
                                    android:text="@string/total_card_payment_amount"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="normal" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center"
                                    android:gravity="center"
                                    android:padding="5dp"
                                    android:text=":"
                                    android:textColor="@color/black"
                                    android:textSize="14dp"
                                    android:textStyle="normal" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_total_card_payment_amount"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end|center"
                                    android:layout_weight="0.8"
                                    android:gravity="end"
                                    android:hint="--"
                                    android:padding="5dp"
                                    android:textAlignment="textEnd"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </TableRow>


                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.4dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:background="@color/black"
                                android:visibility="gone"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/txt_total_earnings" />


                            <TableRow
                                android:id="@+id/tr_payout_balance_card_payment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="10.0dip"
                                android:padding="3dp"
                                android:visibility="gone">

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_payout_admin_balance_label"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center"
                                    android:layout_weight="1.2"
                                    android:gravity="start"
                                    android:padding="5dp"
                                    android:text="@string/payout_balance_for_card_payment"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="normal" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center"
                                    android:gravity="center"
                                    android:padding="5dp"
                                    android:text=":"
                                    android:textColor="@color/black"
                                    android:textSize="14dp"
                                    android:textStyle="normal" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_payout_admin_balance"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end|center"
                                    android:layout_weight="0.8"
                                    android:gravity="end"
                                    android:hint="--"
                                    android:padding="5dp"
                                    android:textAlignment="textEnd"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </TableRow>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.4dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:background="@color/black"
                                android:visibility="gone"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/txt_total_earnings" />

                            <TableRow
                                android:id="@+id/tr_admin_given_balance_amount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="10.0dip"
                                android:padding="3dp"
                                android:visibility="gone">

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_admin_given_amount_label"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center"
                                    android:layout_weight="1.2"
                                    android:gravity="start"
                                    android:padding="5dp"
                                    android:text="@string/admin_given_payout_balance_amount"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="normal" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center"
                                    android:gravity="center"
                                    android:padding="5dp"
                                    android:text=":"
                                    android:textColor="@color/black"
                                    android:textSize="14dp"
                                    android:textStyle="normal" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_admin_given_amount"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end|center"
                                    android:layout_weight="0.8"
                                    android:gravity="end"
                                    android:hint="--"
                                    android:padding="5dp"
                                    android:textAlignment="textEnd"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </TableRow>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.4dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="10dp"
                                android:background="@color/black"
                                android:visibility="visible"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/txt_total_earnings" />

                            <TableRow
                                android:id="@+id/tr_admin_site_commission"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="10.0dip"
                                android:padding="3dp"
                                android:visibility="visible">

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_admin_site_commission_label"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center"
                                    android:layout_weight="1.2"
                                    android:gravity="start"
                                    android:padding="5dp"
                                    android:text="@string/debt"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="normal" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center"
                                    android:gravity="center"
                                    android:padding="5dp"
                                    android:text=":"
                                    android:textColor="@color/black"
                                    android:textSize="14dp"
                                    android:textStyle="normal" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_admin_site_commission"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="end|center"
                                    android:layout_weight="0.8"
                                    android:gravity="end"
                                    android:hint="--"
                                    android:padding="5dp"
                                    android:textAlignment="textEnd"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </TableRow>

                        </TableLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>