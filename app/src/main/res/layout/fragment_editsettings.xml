<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white">

    <android.widget.Toolbar
        android:id="@+id/toolbar_setting"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@drawable/bg_toolbar_gradient">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/imgbtn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:contentDescription="@string/todo"
                style="@style/AppThemeToolBar"
                android:padding="10dp"
                android:src="@drawable/ic_back_whitearrow" />

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/imgbtn_back"
                android:layout_alignBottom="@+id/imgbtn_back"
                android:layout_centerInParent="true"
                android:layout_marginStart="0dp"
                android:layout_toStartOf="@+id/iv_menu_profile"
                android:layout_toEndOf="@+id/imgbtn_back"
                android:foregroundGravity="center"
                android:gravity="center|start"
                android:text="@string/editsettings_editprofile_title"
                style="@style/AppThemeToolBar"
                tools:ignore="MissingPrefix" />

            <ImageView
                android:id="@+id/iv_menu_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="top|right"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/ic_menu_vertical"
                android:contentDescription="@string/todo"
                android:padding="5dp"
                android:visibility="invisible"
                tools:ignore="RtlHardcoded" />
        </RelativeLayout>

    </android.widget.Toolbar>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar_setting"
        android:background="@color/bg_gray_common">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical"
                tools:ignore="UselessParent">

                <RelativeLayout
                    android:id="@+id/imagearea"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">

                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/iv_backcover_user_profile"
                        android:layout_width="fill_parent"
                        android:layout_height="150.0dip"
                        android:contentDescription="@string/todo"
                        android:scaleType="fitXY"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="150.0dip"
                        android:contentDescription="@string/todo"
                        android:src="@color/bg_gray_common"
                        android:visibility="gone" />

                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/iv_user_profile"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="10dp"
                        android:layout_centerInParent="true"
                        android:scaleType="fitXY"
                        app:actualImageScaleType="none"
                        app:placeholderImage="@mipmap/male"
                        app:failureImage="@mipmap/male"
                        app:placeholderImageScaleType="fitXY"
                        app:roundedCornerRadius="0dp"
                        app:roundingBorderColor="@color/colorPrimary" />

                    <ImageView
                        android:id="@+id/iv_camera"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_alignBottom="@+id/iv_user_profile"
                        android:src="@drawable/ic_camera"
                        android:contentDescription="@string/todo"
                        android:tint="#535353"
                        android:padding="5dp"
                        tools:ignore="RtlHardcoded" />

                </RelativeLayout>


                <LinearLayout
                    android:id="@+id/nameArea"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5.0dip"
                    android:layout_marginEnd="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <com.instaguard.provider.CustomViews.CustomEditText
                            android:id="@+id/edt_firstname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginEnd="10dp"
                            android:digits="._abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890@ "
                            android:hint="@string/editsettings_firstname_hint"
                            android:imeOptions="actionNext"
                            android:inputType="textWebEmailAddress"
                            android:textCursorDrawable="@color/black"
                            android:maxLength="25"
                            android:singleLine="true"
                            android:textAlignment="viewStart"
                            android:text=""
                            app:met_floatingLabel="highlight"
                            app:met_floatingLabelAlwaysShown="false"
                            app:met_floatingLabelAnimating="true"
                            android:textColor="@color/black"
                            app:met_baseColor="@color/black"
                            app:met_errorColor="@android:color/holo_red_dark"
                            app:met_floatingLabelTextColor="@color/black"
                            app:met_helperTextColor="@color/black"
                            app:met_primaryColor="@color/black"
                            app:met_textColor="@color/black"
                            app:met_textColorHint="@color/hintgray"
                            app:met_underlineColor="@color/hintgray"/>

                        <ImageButton
                            android:id="@+id/imgbtn_clear_first_name"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_alignTop="@+id/edt_firstname"
                            android:layout_alignBottom="@+id/edt_firstname"
                            android:layout_alignParentEnd="true"
                            android:layout_marginStart="0dp"
                            android:layout_marginTop="0dp"
                            android:layout_marginEnd="0dp"
                            android:background="@null"
                            android:contentDescription="@string/todo"
                            android:padding="10dp"
                            android:src="@drawable/ic_circle_close"
                            android:visibility="gone" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <com.instaguard.provider.CustomViews.CustomEditText
                            android:id="@+id/edt_lastname"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="5dp"
                            android:digits="._abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890@ "
                            android:hint="@string/editsettings_lastname_hint"
                            android:imeOptions="actionNext"
                            android:textCursorDrawable="@color/black"
                            android:inputType="textWebEmailAddress"
                            android:maxLength="25"
                            android:singleLine="true"
                            android:textAlignment="viewStart"
                            android:text=""
                            android:textColor="@color/black"
                            app:met_baseColor="@color/black"
                            app:met_errorColor="@android:color/holo_red_dark"
                            app:met_floatingLabel="highlight"
                            app:met_floatingLabelAlwaysShown="false"
                            app:met_floatingLabelAnimating="true"
                            app:met_floatingLabelTextColor="@color/black"
                            app:met_helperTextColor="@color/black"
                            app:met_primaryColor="@color/black"
                            app:met_textColor="@color/black"
                            app:met_textColorHint="@color/hintgray"
                            app:met_underlineColor="@color/hintgray" />


                        <ImageButton
                            android:id="@+id/imgbtn_clear_last_name"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_alignTop="@+id/edt_lastname"
                            android:layout_alignBottom="@+id/edt_lastname"
                            android:layout_alignParentEnd="true"
                            android:layout_marginStart="0dp"
                            android:layout_marginTop="0dp"
                            android:layout_marginEnd="0dp"
                            android:background="@null"
                            android:contentDescription="@string/todo"
                            android:padding="10dp"
                            android:src="@drawable/ic_circle_close"
                            android:visibility="gone" />

                    </RelativeLayout>
                </LinearLayout>

                <com.instaguard.provider.CustomViews.CustomEditText
                    android:id="@+id/edt_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="false"
                    android:digits="._abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890@ "
                    android:editable="false"
                    android:focusable="false"
                    android:hint="@string/editsettings_email_hint"
                    android:inputType="textEmailAddress"
                    android:paddingEnd="10dp"
                    android:textCursorDrawable="@color/black"
                    android:textAlignment="viewStart"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/black"
                    app:met_baseColor="@color/black"
                    app:met_errorColor="@android:color/holo_red_dark"
                    app:met_floatingLabel="highlight"
                    app:met_floatingLabelAlwaysShown="false"
                    app:met_floatingLabelAnimating="true"
                    app:met_floatingLabelTextColor="@color/black"
                    app:met_helperTextColor="@color/black"
                    app:met_primaryColor="@color/black"
                    app:met_textColor="@color/black"
                    app:met_textColorHint="@color/hintgray"
                    app:met_underlineColor="@color/hintgray"
                    tools:ignore="RtlSymmetry" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="horizontal">

                    <com.instaguard.provider.CustomViews.CustomEditText
                        android:id="@+id/edt_country_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:clickable="false"
                        android:editable="false"
                        android:focusable="false"
                        android:hint="@string/editsettings_country_hint"
                        android:singleLine="true"
                        android:textAlignment="viewStart"
                        android:text=""
                        android:textCursorDrawable="@color/black"
                        android:visibility="visible"
                        android:textColor="@color/black"
                        app:met_baseColor="@color/black"
                        app:met_errorColor="@android:color/holo_red_dark"
                        app:met_floatingLabel="highlight"
                        app:met_floatingLabelAlwaysShown="false"
                        app:met_floatingLabelAnimating="true"
                        app:met_floatingLabelTextColor="@color/black"
                        app:met_helperTextColor="@color/black"
                        app:met_primaryColor="@color/black"
                        app:met_textColor="@color/black"
                        app:met_textColorHint="@color/hintgray"
                        app:met_underlineColor="@color/hintgray" />

                    <com.instaguard.provider.Helpers.CountryCode.CountryCodePicker
                        android:id="@+id/ccp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:keyboardAutoPopOnSearch="false" />

                    <com.instaguard.provider.CustomViews.CustomEditText
                        android:id="@+id/edt_mobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="false"
                        android:digits="0123456789"
                        android:editable="false"
                        android:focusable="false"
                        android:hint="@string/editsettings_mobile_hint"
                        android:imeOptions="actionNext"
                        android:textCursorDrawable="@color/black"
                        android:inputType="phone"
                        android:maxLength="15"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:textAlignment="viewStart"
                        android:text=""
                        android:textColor="@color/black"
                        app:met_baseColor="@color/black"
                        app:met_errorColor="@android:color/holo_red_dark"
                        app:met_floatingLabel="highlight"
                        app:met_floatingLabelAlwaysShown="false"
                        app:met_floatingLabelAnimating="true"
                        app:met_floatingLabelTextColor="@color/black"
                        app:met_helperTextColor="@color/black"
                        app:met_primaryColor="@color/black"
                        app:met_textColor="@color/black"
                        app:met_textColorHint="@color/hintgray"
                        app:met_underlineColor="@color/hintgray"
                        tools:ignore="RtlSymmetry" />

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/cityLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.instaguard.provider.CustomViews.CustomEditText
                        android:id="@+id/edt_city"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="10dp"
                        android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890`~!@#$%^*()-_+=|{}[]:;&apos;&lt;&gt;&amp;/"
                        android:hint="@string/select_your_town"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        android:textCursorDrawable="@color/black"
                        app:met_baseColor="@color/black"
                        app:met_errorColor="@android:color/holo_red_dark"
                        app:met_floatingLabel="highlight"
                        app:met_floatingLabelAlwaysShown="false"
                        app:met_floatingLabelAnimating="true"
                        app:met_floatingLabelTextColor="@color/black"
                        app:met_helperTextColor="@color/black"
                        app:met_primaryColor="@color/black"
                        app:met_textColor="@color/black"
                        app:met_textColorHint="@color/hintgray"
                        app:met_underlineColor="@color/hintgray"
                        android:focusable="false"
                        android:clickable="false"
                        tools:ignore="RtlSymmetry" />

                   <!-- <Spinner
                        android:id="@+id/select_city"
                        style="@style/Base.Widget.AppCompat.Spinner.Underlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:backgroundTint="@color/gray_light"
                        android:gravity="start"
                        android:textSize="18sp"/>-->

                </RelativeLayout>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.instaguard.provider.CustomViews.CustomEditText
                        android:id="@+id/edt_service_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="10dp"
                        android:digits="._abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890@ "
                        android:hint="@string/editsettings_desc_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textWebEmailAddress"
                        android:singleLine="true"
                        android:textCursorDrawable="@color/black"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        app:met_baseColor="@color/black"
                        app:met_errorColor="@android:color/holo_red_dark"
                        app:met_floatingLabel="highlight"
                        app:met_floatingLabelAlwaysShown="false"
                        app:met_floatingLabelAnimating="true"
                        app:met_floatingLabelTextColor="@color/black"
                        app:met_helperTextColor="@color/black"
                        app:met_primaryColor="@color/black"
                        app:met_textColor="@color/black"
                        app:met_textColorHint="@color/hintgray"
                        app:met_underlineColor="@color/hintgray" />

                    <ImageButton
                        android:id="@+id/imgbtn_clear_servc_desc"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_alignTop="@+id/edt_service_desc"
                        android:layout_alignBottom="@+id/edt_service_desc"
                        android:layout_alignParentEnd="true"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginEnd="10dp"
                        android:background="@null"
                        android:foregroundGravity="center"
                        android:contentDescription="@string/todo"
                        android:padding="10dp"
                        android:src="@drawable/ic_circle_close"
                        android:visibility="gone" />

                </RelativeLayout>

                <com.instaguard.provider.CustomViews.CustomEditText
                    android:id="@+id/edt_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="false"
                    android:digits="0123456789"
                    android:drawableEnd="@drawable/ic_arrow_drop_down_black"
                    android:editable="false"
                    android:focusable="false"
                    android:focusableInTouchMode="true"
                    android:hint="@string/editsettings_language_hint"
                    android:imeOptions="actionNone"
                    android:maxLength="15"
                    android:textAlignment="viewStart"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:visibility="gone"
                    android:text="English"
                    app:met_floatingLabel="highlight"
                    app:met_floatingLabelAlwaysShown="false"
                    app:met_floatingLabelAnimating="true"
                    app:met_floatingLabelTextColor="@color/colorPrimary"
                    app:met_textColorHint="@color/colorPrimary"
                    tools:ignore="RtlSymmetry" />

                <com.instaguard.provider.CustomViews.CustomEditText
                    android:id="@+id/edt_company_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:hint="@string/settings_Company_hint"
                    android:imeOptions="actionNone"
                    android:maxLength="30"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    app:met_baseColor="@color/black"
                    app:met_errorColor="@android:color/holo_red_dark"
                    app:met_floatingLabel="highlight"
                    app:met_floatingLabelAlwaysShown="false"
                    app:met_floatingLabelAnimating="true"
                    app:met_floatingLabelTextColor="@color/black"
                    app:met_helperTextColor="@color/black"
                    app:met_hideUnderline="true"
                    app:met_primaryColor="@color/black"
                    app:met_textColor="@color/black"
                    app:met_textColorHint="@color/hintgray"
                    app:met_underlineColor="@color/hintgray"
                    tools:ignore="RtlSymmetry" />
                <com.instaguard.provider.CustomViews.CustomEditText
                    android:id="@+id/edt_currency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="false"
                    android:digits="0123456789"
                    android:drawableEnd="@drawable/ic_arrow_drop_down_black"
                    android:editable="false"
                    android:focusable="false"
                    android:focusableInTouchMode="true"
                    android:textAlignment="viewStart"
                    android:hint="@string/editsettings_currency_hint"
                    android:imeOptions="actionNone"
                    android:maxLength="15"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="USD"
                    app:met_floatingLabel="highlight"
                    app:met_floatingLabelAlwaysShown="false"
                    app:met_floatingLabelAnimating="true"
                    app:met_floatingLabelTextColor="@color/black"
                    app:met_underlineColor="@color/hintgray"
                    app:met_textColorHint="@color/hintgray"
                    tools:ignore="RtlSymmetry" />


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp">

                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_updatesettings"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_rect_filled_colorprimary"
                        android:contentDescription="@string/todo"
                        android:text="@string/editsettings_update_information_btn_text"
                        android:textColor="@color/white" />


                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_update_change_password"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_centerHorizontal="true"
                        android:layout_below="@+id/btn_updatesettings"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_rect_filled_colorprimary"
                        android:contentDescription="@string/todo"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/change_password_title"
                        android:textColor="@color/white" />

                </RelativeLayout>

            </LinearLayout>

        </RelativeLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/frame_editprofile"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    </FrameLayout>
</RelativeLayout>