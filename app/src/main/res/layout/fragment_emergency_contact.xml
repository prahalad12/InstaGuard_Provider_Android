<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_gray_common">

        <android.widget.Toolbar
            android:id="@+id/toolbar_emergency"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@drawable/bg_toolbar_gradient">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/imgbtn_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:contentDescription="@string/todo"
                    android:padding="10dp"
                    style="@style/AppThemeToolBar"
                    android:src="@drawable/ic_back_whitearrow" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@+id/imgbtn_back"
                    android:layout_alignTop="@+id/imgbtn_back"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="0dp"
                    android:layout_toEndOf="@+id/imgbtn_back"
                    android:layout_toStartOf="@+id/iv_menu_profile"
                    android:foregroundGravity="center"
                    android:gravity="center|start"
                    android:text="@string/emergency_contacts"
                    style="@style/AppThemeToolBar"
                    tools:ignore="MissingPrefix" />

                <ImageView
                    android:id="@+id/iv_menu_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_gravity="top|right"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ic_menu_vertical"
                    android:contentDescription="@string/todo"
                    android:padding="5dp"
                    android:visibility="gone"
                    tools:ignore="RtlHardcoded" />
            </RelativeLayout>

        </android.widget.Toolbar>


        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_below="@+id/toolbar_emergency"
            tools:ignore="UselessParent">

            <LinearLayout
                android:id="@+id/rl_noContactArea"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:padding="10.0dip"
                android:layout_above="@+id/rl_bottom_add_contact"
                android:visibility="visible">

                <ImageView
                    android:layout_width="120.0dip"
                    android:layout_height="120.0dip"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="45.0dip"
                    android:src="@mipmap/ic_eme_banner"
                    android:tint="@color/black" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_msg_content"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dip"
                    android:gravity="center"
                    android:text="@string/emergency_contacts_make_your_travel_safe"
                    android:textColor="@color/colorPrimary"
                    android:textSize="18sp" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_msg_content_subtitle"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20.0dip"
                    android:gravity="center"
                    android:paddingEnd="20.0dip"
                    android:paddingStart="20.0dip"
                    android:text="@string/emergency_contacts_send_alert_to_your_friends_family_memebers_in_case_of_an_emergency"
                    android:textColor="#ff333333"
                    android:textSize="16sp" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_msg_content_subtitle_two"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20.0dip"
                    android:gravity="center"
                    android:paddingEnd="20.0dip"
                    android:paddingStart="20.0dip"
                    android:text="@string/emergency_contacts_please_add_them_to_your_emergency_contacts"
                    android:textColor="#ff333333"
                    android:textSize="16sp" />
            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_emergency_view"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_gravity="center"
                android:layout_margin="5.0dip"
                android:orientation="vertical"
                android:padding="5dp"
                android:visibility="visible"
                android:layout_above="@+id/rl_bottom_add_contact"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />


            <LinearLayout
                android:id="@+id/rl_bottom_add_contact"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="13.0dip"
                android:layout_marginEnd="19.0dip"
                android:layout_marginStart="19.0dip"
                android:orientation="vertical"
                android:visibility="visible"
                android:layout_marginTop="15.0dip">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_notify"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8.0dip"
                    android:layout_marginBottom="15dp"
                    android:text="@string/emergency_contacts_you_can_add_up_to_5_contacts"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16sp" />

                <com.instaguard.provider.CustomViews.CustomButton
                    android:id="@+id/btn_add_contact"
                    android:layout_width="fill_parent"
                    android:layout_height="45sp"
                    android:background="@drawable/bg_rect_filled_colorprimary"
                    android:text="@string/emergency_contacts_add_contacts"
                    android:textColor="@color/white" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</LinearLayout>