<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame_forgot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Fragments.ForgotPasswordFragment">

    <RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:ignore="UselessParent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <android.widget.Toolbar
                    android:id="@+id/toolbar_forgetpassword"
                    android:layout_width="match_parent"
                    android:layout_height="?android:attr/actionBarSize"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/bg_toolbar_gradient">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                    <ImageButton
                        android:id="@+id/imgbtn_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:contentDescription="@string/todo"
                        style="@style/AppThemeToolBar"
                        android:padding="10dp"
                        android:layout_alignParentStart="true"
                        android:src="@drawable/ic_back_whitearrow" />
                    <ImageButton
                        android:id="@+id/imgbtn_backs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:visibility="invisible"
                        android:layout_alignParentEnd="true"
                        android:contentDescription="@string/todo"
                        android:padding="10dp"
                        android:src="@drawable/ic_back_whitearrow" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="0dp"
                        android:layout_marginEnd="0dp"
                        android:layout_toStartOf="@+id/imgbtn_backs"
                        android:layout_toEndOf="@+id/imgbtn_back"
                        android:layout_alignTop="@+id/imgbtn_back"
                        android:layout_alignBottom="@+id/imgbtn_back"
                        android:gravity="center"
                        android:text="@string/forgot_password_title"
                        style="@style/AppThemeToolBar"
                        tools:ignore="MissingPrefix" />

                    </RelativeLayout>
                </android.widget.Toolbar>

                <!--Change password forgotPasswordOTPData verify-->

                <LinearLayout
                    android:id="@+id/llsetfullcontrol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/toolbar_forgetpassword"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible">


                    <!--First visible layout-->
                    <LinearLayout
                        android:id="@+id/ll_mobile_lyt"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:contentDescription="@string/todo"
                            android:tint="@color/black"
                            android:foregroundGravity="center"
                            android:src="@drawable/ic_lock" />


                        <RelativeLayout
                            android:id="@+id/rl_email_verification"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:visibility="visible">


                            <com.instaguard.provider.CustomViews.CustomTextView
                                android:id="@+id/txt_email_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:layout_marginBottom="20dp"
                                android:paddingStart="20dp"
                                android:paddingEnd="30dp"
                                android:text="@string/forgetpassword_enter_email_instruction_hint"
                                android:textAlignment="center"
                                android:textColor="@android:color/darker_gray" />


                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/txt_email_title">

                                <com.instaguard.provider.CustomViews.CustomEditText
                                    android:id="@+id/edt_email"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="20dp"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginEnd="20dp"
                                    android:hint="@string/forgot_password_email_hint"
                                    android:inputType="textEmailAddress"
                                    android:paddingEnd="10dp"
                                    android:singleLine="true"
                                    android:visibility="visible"
                                    app:met_floatingLabel="highlight"
                                    app:met_floatingLabelAlwaysShown="false"
                                    app:met_floatingLabelAnimating="true"
                                    app:met_textColorHint="@color/hintgray" />

                                <ImageButton
                                    android:id="@+id/imgbtn_clear_email"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignTop="@+id/edt_email"
                                    android:layout_alignBottom="@+id/edt_email"
                                    android:layout_alignParentEnd="true"
                                    android:layout_marginStart="20dp"
                                    android:layout_marginTop="0dp"
                                    android:layout_marginEnd="20dp"
                                    android:background="@null"
                                    android:contentDescription="@string/todo"
                                    android:padding="10dp"
                                    android:src="@drawable/ic_circle_close"
                                    android:visibility="gone" />

                            </RelativeLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/txt_email_title"
                                android:layout_marginStart="20dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginEnd="20dp"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <com.instaguard.provider.CustomViews.CustomEditText
                                    android:id="@+id/edt_country_code"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:drawableEnd="@drawable/ic_arrow_drop_down_black"
                                    android:focusable="false"
                                    android:hint="@string/register_country_hint"
                                    android:singleLine="true"
                                    app:met_floatingLabel="highlight"
                                    app:met_floatingLabelAlwaysShown="false"
                                    app:met_floatingLabelAnimating="true"
                                    app:met_iconPadding="0dp"
                                    app:met_textColorHint="@color/hintgray" />

                                <com.instaguard.provider.Helpers.CountryCode.CountryCodePicker
                                    android:id="@+id/ccp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone"
                                    app:keyboardAutoPopOnSearch="false" />

                                <com.instaguard.provider.CustomViews.CustomEditText
                                    android:id="@+id/edt_mobile"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginEnd="10dp"
                                    android:digits="0123456789"
                                    android:hint="@string/register_mobile_hint"
                                    android:imeOptions="actionNext"
                                    android:inputType="phone"
                                    android:maxLength="15"
                                    android:paddingEnd="10dp"
                                    android:singleLine="true"
                                    app:met_floatingLabel="highlight"
                                    app:met_floatingLabelAlwaysShown="false"
                                    app:met_floatingLabelAnimating="true"
                                    app:met_textColorHint="@color/hintgray"
                                    tools:ignore="RtlSymmetry" />

                            </LinearLayout>


                        </RelativeLayout>


                        <com.instaguard.provider.CustomViews.CustomButton
                            android:id="@+id/btn_confirmforgot"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginEnd="20dp"
                            android:background="@drawable/bg_rect_filled_colorprimary"
                            android:contentDescription="@string/todo"
                            android:text="@string/forgot_password_continue_hint"
                            android:textColor="@color/white" />

                    </LinearLayout>


                    <!--Second visible layout-->
                    <LinearLayout
                        android:id="@+id/ll_reset_password"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <RelativeLayout
                            android:id="@+id/rl_reset_verification"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:visibility="visible">

                            <com.instaguard.provider.CustomViews.CustomTextView
                                android:id="@+id/txt_reset_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:layout_marginBottom="20dp"
                                android:paddingStart="20dp"
                                android:paddingEnd="30dp"
                                android:text="Enter the reset password and confirm password"
                                android:textAlignment="center"
                                android:textColor="@android:color/darker_gray" />

                            <RelativeLayout
                                android:id="@+id/rl_password_lyt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/txt_reset_title">

                                <com.instaguard.provider.CustomViews.CustomEditText
                                    android:id="@+id/edt_resetpwd"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"

                                    android:layout_marginStart="20dp"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginEnd="20dp"
                                    android:hint="Password"
                                    android:inputType="textPassword"
                                    android:paddingEnd="10dp"
                                    android:singleLine="true"
                                    app:met_floatingLabel="highlight"
                                    app:met_floatingLabelAlwaysShown="false"
                                    app:met_floatingLabelAnimating="true"
                                    app:met_textColorHint="@color/colorPrimary" />

                                <ImageButton
                                    android:id="@+id/imgbtn_clear_pwd"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignTop="@+id/edt_resetpwd"
                                    android:layout_alignBottom="@+id/edt_resetpwd"
                                    android:layout_alignParentEnd="true"
                                    android:layout_marginStart="20dp"
                                    android:layout_marginTop="0dp"
                                    android:layout_marginEnd="20dp"
                                    android:background="@null"
                                    android:contentDescription="@string/todo"
                                    android:padding="10dp"
                                    android:src="@drawable/ic_circle_close"
                                    android:visibility="gone" />

                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/rl_cnf_password_lyt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/rl_password_lyt">


                                <com.instaguard.provider.CustomViews.CustomEditText
                                    android:id="@+id/edt_confirepwd"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="20dp"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginEnd="20dp"
                                    android:hint="Confirm Password"
                                    android:inputType="textPassword"
                                    android:paddingRight="10dp"
                                    android:singleLine="true"
                                    app:met_floatingLabel="highlight"
                                    app:met_floatingLabelAlwaysShown="false"
                                    app:met_floatingLabelAnimating="true"
                                    app:met_textColorHint="@color/colorPrimary" />

                                <ImageButton
                                    android:id="@+id/imgbtn_clear_cnf_pwd"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignTop="@+id/edt_confirepwd"
                                    android:layout_alignBottom="@+id/edt_confirepwd"
                                    android:layout_alignParentEnd="true"
                                    android:layout_marginStart="20dp"
                                    android:layout_marginTop="0dp"
                                    android:layout_marginEnd="20dp"
                                    android:background="@null"
                                    android:contentDescription="@string/todo"
                                    android:padding="10dp"
                                    android:src="@drawable/ic_circle_close"
                                    android:visibility="gone" />

                            </RelativeLayout>

                        </RelativeLayout>

                        <com.instaguard.provider.CustomViews.CustomButton
                            android:id="@+id/btn_resetforgot"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginEnd="20dp"
                            android:background="@drawable/bg_rect_filled_colorprimary"
                            android:contentDescription="@string/todo"
                            android:text="@string/forgetpassword_submit"
                            android:textColor="@color/white" />


                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>


</FrameLayout>