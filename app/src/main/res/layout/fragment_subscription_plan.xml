<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@color/bg_gray_common"
        android:orientation="vertical">

        <android.widget.Toolbar
            android:id="@+id/toolbar_scbs_plan"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_toolbar_gradient">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/imgbtn_back"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_back_whitearrow"
                    tools:ignore="ContentDescription" />

                <ImageButton
                    android:id="@+id/imgbtn_backs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_chevron_left_black"
                    android:visibility="invisible"
                    tools:ignore="ContentDescription" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_scbs_plan_header"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/imgbtn_backs"
                    android:layout_alignBottom="@+id/imgbtn_backs"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_toStartOf="@+id/txt_skip_subs_plan_header"
                    android:layout_toEndOf="@+id/imgbtn_back"
                    android:text="@string/nav_mymembership"
                    android:textAllCaps="true"
                    tools:ignore="MissingPrefix,RtlHardcoded" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_skip_subs_plan_header"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/imgbtn_backs"
                    android:layout_alignBottom="@+id/imgbtn_backs"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="0dp"
                    android:layout_toStartOf="@+id/btn_continue_subscr_plan_view_history"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/skip"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    tools:ignore="MissingPrefix,RtlHardcoded" />

                <com.instaguard.provider.CustomViews.CustomButton
                    android:id="@+id/btn_continue_subscr_plan_view_history"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/imgbtn_backs"
                    android:layout_alignBottom="@+id/imgbtn_backs"
                    android:layout_alignParentEnd="true"
                    android:layout_gravity="center"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="0dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/todo"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/subs_plan_history"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:visibility="visible" />


            </RelativeLayout>

        </android.widget.Toolbar>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/ll_your_subscription_view_lyt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_view_subscr_plan_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@color/colorPrimary"
                            android:contentDescription="@string/todo"
                            android:gravity="center"
                            android:paddingStart="15dp"
                            android:paddingTop="25dp"
                            android:paddingEnd="15dp"
                            android:paddingBottom="40dp"
                            android:text="@string/your_subs_plan"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10sp"
                            android:layout_marginTop="-25dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginBottom="10dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="4dp"
                            app:cardElevation="5dp">

                            <RelativeLayout
                                android:id="@+id/rl_top_subs_plan_lyt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/white"
                                android:padding="5dp">

                                <ImageView
                                    android:id="@+id/img_offers"
                                    android:layout_width="45dp"
                                    android:layout_height="45dp"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerHorizontal="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="5dp"
                                    android:layout_marginTop="5dp"
                                    android:layout_marginEnd="5dp"
                                    android:layout_marginBottom="5dp"
                                    android:background="@drawable/ic_circle_color_gray"
                                    android:backgroundTint="@color/colorPrimaryDark"
                                    android:contentDescription="@string/todo"
                                    android:padding="10dp"
                                    android:src="@drawable/ic_round_local_offer_24"
                                    app:tint="@color/white" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignTop="@+id/img_offers"
                                    android:layout_marginStart="5dp"
                                    android:layout_marginEnd="5dp"
                                    android:layout_toStartOf="@+id/img_check"
                                    android:layout_toEndOf="@+id/img_offers"
                                    android:orientation="vertical">

                                    <com.instaguard.provider.CustomViews.CustomTextView
                                        android:id="@+id/txt_title_subs"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:gravity="center|start"
                                        android:hint="--"
                                        android:textAlignment="viewStart"
                                        android:textColor="@color/colorPrimary"
                                        android:textColorHint="@color/colorPrimary"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <com.instaguard.provider.CustomViews.CustomTextView
                                        android:id="@+id/txt_message"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:layout_marginTop="5dp"
                                        android:gravity="center|start"
                                        android:hint="--"
                                        android:maxLines="2"
                                        android:textAlignment="viewStart"
                                        android:textColor="@color/colorPrimary"
                                        android:textColorHint="@color/colorPrimary"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <com.instaguard.provider.CustomViews.CustomTextView
                                        android:id="@+id/txt_date"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginTop="5dp"
                                        android:layout_marginBottom="5dp"
                                        android:gravity="center|start"
                                        android:hint="--"
                                        android:textAlignment="viewStart"
                                        android:textColor="@color/colorPrimary"
                                        android:textColorHint="@color/colorPrimary"
                                        android:textSize="15sp"
                                        android:visibility="visible" />

                                    <com.instaguard.provider.CustomViews.CustomTextView
                                        android:id="@+id/txt_disable_autorenew"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center|start"
                                        android:layout_marginTop="5dp"
                                        android:layout_marginBottom="5dp"
                                        android:background="@drawable/bg_rect_cp_curve_plan"
                                        android:backgroundTint="@android:color/holo_red_light"
                                        android:gravity="center|start"
                                        android:padding="5dp"
                                        android:text="@string/disable_autorenew"
                                        android:textAlignment="viewStart"
                                        android:textColor="@android:color/white"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:visibility="gone"
                                        tools:targetApi="m" />

                                    <com.instaguard.provider.CustomViews.CustomTextView
                                        android:id="@+id/txt_enable_autorenew"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center|start"
                                        android:layout_marginTop="5dp"
                                        android:layout_marginBottom="5dp"
                                        android:background="@drawable/bg_rect_cp_curve_plan"
                                        android:gravity="center|start"
                                        android:padding="5dp"
                                        android:text="@string/enable_autorenew"
                                        android:textAlignment="viewStart"
                                        android:textColor="@android:color/white"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:visibility="gone" />

                                </LinearLayout>

                                <ImageView
                                    android:id="@+id/img_check"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerHorizontal="true"
                                    android:layout_centerVertical="true"
                                    android:layout_margin="5dp"
                                    android:contentDescription="@string/todo"
                                    android:src="@drawable/ic_baseline_info_20"
                                    android:visibility="visible"
                                    app:tint="@color/colorPrimary" />

                            </RelativeLayout>

                        </androidx.cardview.widget.CardView>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.2dp"
                            android:background="@color/gray_light" />

                    </LinearLayout>


                    <com.instaguard.provider.CustomViews.CustomButton
                        android:id="@+id/btn_buy_subscr_plan_"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="50dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_rect_cp_curve_plan"
                        android:backgroundTint="@color/black"
                        android:contentDescription="@string/todo"
                        android:padding="10dp"
                        android:text="@string/buy_plan"
                        android:textAllCaps="true"
                        android:textColor="@color/colorPrimary"
                        android:visibility="gone" />

                    <com.instaguard.provider.CustomViews.CustomTextView
                        style="@style/AppThemeToolBarCenter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:gravity="center"
                        android:padding="5dp"
                        android:text="@string/available_plan"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:visibility="gone"
                        tools:ignore="MissingPrefix,RtlHardcoded" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.2dp"
                        android:background="@color/gray_light"
                        android:visibility="gone" />

                    <RelativeLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/ll_available_plans"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rcv_subscription_plan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="5dp"
                                android:visibility="visible"
                                tools:itemCount="3"
                                tools:listitem="@layout/adapter_subscription_plan_view" />

                            <com.instaguard.provider.CustomViews.CustomTextView
                                android:id="@+id/txt_no_records"
                                style="@style/AppThemeToolBarCenter"
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                android:layout_gravity="center"
                                android:layout_margin="10dp"
                                android:gravity="center"
                                android:padding="5dp"
                                android:text="@string/no_record_found"
                                android:textAllCaps="false"
                                android:textColor="@color/black"
                                android:visibility="gone"
                                tools:ignore="MissingPrefix,RtlHardcoded" />

                            <com.instaguard.provider.CustomViews.CustomButton
                                android:id="@+id/btn_continue_subscr_plan"
                                android:layout_width="match_parent"
                                android:layout_height="45dp"
                                android:layout_gravity="center"
                                android:layout_marginStart="20dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginEnd="20dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/bg_rect_filled_colorprimary"
                                android:contentDescription="@string/todo"
                                android:text="@string/booking_continue"
                                android:textColor="@color/white"
                                android:visibility="gone" />

                        </LinearLayout>

                        <View
                            android:id="@+id/view_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_alignTop="@+id/ll_available_plans"
                            android:layout_alignBottom="@+id/ll_available_plans"
                            android:layout_margin="5dp"
                            android:alpha="0.3"
                            android:background="@drawable/bg_rect_cp_curve_plan"
                            android:backgroundTint="@color/gray_very_light"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:visibility="gone" />

                    </RelativeLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rl_progress_bar_cnf"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBlacktransperant"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_margin="50dp"
            android:backgroundTint="@color/white"
            android:indeterminateTint="@color/white"
            android:progressTint="@color/white" />

    </RelativeLayout>

    <FrameLayout
        android:id="@+id/frame_subs_plan"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/lyt_subscription_plan_view"
        layout="@layout/dialog_subscription_plan_view"
        android:visibility="gone" />

    <include
        android:id="@+id/lyt_payment_paynow_view"
        layout="@layout/layout_payment_paynow_scan"
        android:visibility="gone" />

    <include
        android:id="@+id/lyt_success"
        layout="@layout/layout_success"
        android:visibility="gone" />

</RelativeLayout>