<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@color/bg_gray_common"
        android:orientation="vertical">

        <android.widget.Toolbar
            android:id="@+id/toolbar_scbs_plan"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_toolbar_gradient">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/imgbtn_back"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_back_whitearrow"
                    tools:ignore="ContentDescription" />

                <ImageButton
                    android:id="@+id/imgbtn_backs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_chevron_left_black"
                    android:visibility="invisible"
                    tools:ignore="ContentDescription" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_scbs_plan_header"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/imgbtn_backs"
                    android:layout_alignBottom="@+id/imgbtn_backs"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_toStartOf="@+id/txt_skip_subs_plan_header"
                    android:layout_toEndOf="@+id/imgbtn_back"
                    android:text="@string/subscription_plan"
                    android:textAllCaps="true"

                    tools:ignore="MissingPrefix,RtlHardcoded" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_skip_subs_plan_header"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/imgbtn_backs"
                    android:layout_alignBottom="@+id/imgbtn_backs"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="20dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/skip"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    tools:ignore="MissingPrefix,RtlHardcoded" />

            </RelativeLayout>

        </android.widget.Toolbar>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/ll_available_plans"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcv_subscription_plan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:visibility="visible"
                    tools:itemCount="3"
                    tools:listitem="@layout/adapter_subscription_plan_view_history" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_no_records"
                    style="@style/AppThemeToolBarCenter"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_margin="10dp"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="@string/no_record_found"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    tools:ignore="MissingPrefix,RtlHardcoded" />

            </LinearLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rl_progress_bar_cnf"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBlacktransperant"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_margin="50dp"
            android:backgroundTint="@color/white"
            android:indeterminateTint="@color/white"
            android:progressTint="@color/white" />

    </RelativeLayout>

</RelativeLayout>