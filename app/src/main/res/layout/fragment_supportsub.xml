<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_support_header"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_gray_common"
        android:orientation="vertical">

        <android.widget.Toolbar
            android:id="@+id/toolbar_support"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@drawable/bg_toolbar_gradient">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/imgbtn_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:contentDescription="@string/todo"
                    style="@style/AppThemeToolBar"
                    android:padding="10dp"
                    android:src="@drawable/ic_back_whitearrow" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_supportsub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/imgbtn_back"
                    android:layout_alignBottom="@+id/imgbtn_back"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="0dp"
                    android:layout_toStartOf="@+id/iv_menu_profile"
                    android:layout_toEndOf="@+id/imgbtn_back"
                    android:foregroundGravity="center"
                    android:gravity="center|start"
                    android:text="@string/support_header"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    style="@style/AppThemeToolBar"
                    android:textSize="18sp"
                    tools:ignore="MissingPrefix" />

                <ImageView
                    android:id="@+id/iv_menu_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_gravity="top|right"
                    android:layout_alignTop="@+id/imgbtn_back"
                    android:layout_alignBottom="@+id/imgbtn_back"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/ic_menu_vertical"
                    android:contentDescription="@string/todo"
                    android:padding="5dp"
                    style="@style/AppThemeToolBar"
                    android:visibility="invisible"
                    tools:ignore="RtlHardcoded" />

            </RelativeLayout>


        </android.widget.Toolbar>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:id="@+id/ll_description"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20.0dip"
                    android:layout_marginTop="10.0dip"
                    android:orientation="horizontal"
                    android:visibility="visible">


                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:clickable="false"
                        android:gravity="start|center"
                        android:text="@string/com_facebook_loading"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_contactus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ll_description"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dip"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.instaguard.provider.CustomViews.CustomEditText
                        android:id="@+id/edt_reasontocontact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="10dp"
                        android:hint="@string/supportsub_enter_subject_here"
                        android:imeOptions="actionNext"
                        android:maxLength="15"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:text="@string/supportsub_your_query"
                        app:met_floatingLabel="highlight"
                        app:met_floatingLabelAlwaysShown="true"
                        app:met_floatingLabelAnimating="true"
                        app:met_textColorHint="@color/colorPrimary"
                        tools:ignore="RtlSymmetry" />

                    <com.instaguard.provider.CustomViews.CustomEditText
                        android:id="@+id/edt_yourquery"
                        android:layout_width="match_parent"
                        android:layout_height="150.0dip"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="10dp"
                        android:hint="@string/supportsub_enter_subject_here"
                        android:imeOptions="actionNext"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:text="@string/supportsub_write_your_query_here"
                        app:met_floatingLabel="highlight"
                        app:met_floatingLabelAlwaysShown="true"
                        app:met_floatingLabelAnimating="true"
                        app:met_textColorHint="@color/colorPrimary"
                        tools:ignore="RtlSymmetry" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp">

                        <com.instaguard.provider.CustomViews.CustomButton
                            android:id="@+id/supportsub_btn_sendquery"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_alignParentBottom="true"
                            android:layout_gravity="center"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginBottom="20dp"
                            android:background="@drawable/bg_rect_filled_colorprimary"
                            android:contentDescription="@string/todo"
                            android:text="@string/supportsub_send_query"
                            android:textColor="@color/white" />
                    </RelativeLayout>

                </LinearLayout>

            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</LinearLayout>