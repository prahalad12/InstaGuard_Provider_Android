<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frame_mywallet"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/rl_parent_lyt_wallet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:ignore="UselessParent">

        <android.widget.Toolbar
            android:id="@+id/toolbar_wallet"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_toolbar_gradient">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/imgbtn_back"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:contentDescription="@string/todo"
                    android:padding="10dp"
                    android:src="@drawable/ic_back_whitearrow" />

                <ImageButton
                    android:id="@+id/imgbtn_backs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@null"
                    android:contentDescription="@string/todo"
                    android:padding="10dp"
                    android:src="@drawable/ic_back_whitearrow"
                    android:visibility="invisible" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/textView"
                    style="@style/AppThemeToolBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/imgbtn_backs"
                    android:layout_alignBottom="@+id/imgbtn_backs"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_toStartOf="@+id/imgbtn_backs"
                    android:layout_toEndOf="@+id/imgbtn_back"
                    android:gravity="center"
                    android:text="@string/your_transaction_header"
                    tools:ignore="MissingPrefix" />

            </RelativeLayout>

        </android.widget.Toolbar>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/toolbar_wallet"
            android:background="@color/bg_gray_common">

            <LinearLayout
                android:id="@+id/ll_wallet_header"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:ignore="UselessParent">

                <LinearLayout
                    android:id="@+id/ll_header_area"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="10.0dip"
                                android:layout_marginTop="30.0dip"
                                android:layout_marginEnd="10.0dip"
                                android:gravity="center_vertical"
                                android:orientation="vertical">

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_yourbalance"
                                    style="@style/AppThemeToolBarCenter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:text="@string/my_wallet_your_balance_text"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="13.0sp" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_walletamount"
                                    style="@style/AppThemeToolBarCenter"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5.0dip"
                                    android:layout_marginBottom="5.0dip"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="@string/my_wallet_500"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="53.0sp" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.2dp"
                                android:visibility="gone"
                                android:background="@color/gray" />

                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="10.0dip"
                                android:layout_marginTop="20.0dip"
                                android:layout_marginEnd="10.0dip"
                                android:layout_marginBottom="10.0dip"
                                android:gravity="center_vertical"
                                android:visibility="gone"
                                android:orientation="vertical">

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_yourbalance_bonus"
                                    style="@style/AppThemeToolBarCenter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:text="Your Bonus Balance"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="13.0sp" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_walletamount_bonus"
                                    style="@style/AppThemeToolBarCenter"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5.0dip"
                                    android:layout_marginBottom="5.0dip"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:text="@string/my_wallet_500"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="53.0sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0.2dp"
                                android:background="@color/gray" />

                            <com.instaguard.provider.CustomViews.CustomButton
                                android:id="@+id/btn_viewtransactions"
                                android:layout_width="fill_parent"
                                android:layout_height="45sp"
                                android:layout_gravity="bottom"
                                android:layout_margin="25.0dip"
                                android:background="@drawable/bg_rect_filled_colorprimary"
                                android:text="@string/my_wallet_view_transactions_btn_text"
                                android:textAllCaps="true"
                                android:textColor="@color/white"
                                android:visibility="visible" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:id="@+id/ll_addmoney_header"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="#fff2f2f4"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <androidx.cardview.widget.CardView
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent">

                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/white"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10.0dip"
                                    android:layout_marginTop="15.0dip"
                                    android:layout_marginEnd="10.0dip"
                                    android:layout_marginBottom="5.0dip"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical">

                                    <com.instaguard.provider.CustomViews.CustomTextView
                                        android:id="@+id/txt_addmoney"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="15.0dip"
                                        android:gravity="start|center"
                                        android:maxLines="1"
                                        android:text="@string/my_wallet_add_money_text"
                                        android:textAlignment="viewStart"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="16sp" />

                                    <com.instaguard.provider.CustomViews.CustomTextView
                                        android:id="@+id/txt_addmoney_tag"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="15.0dip"
                                        android:layout_marginTop="5.0dip"
                                        android:layout_marginBottom="5.0dip"
                                        android:gravity="start|center"
                                        android:text="@string/my_wallet_it_s_safe_and_secure_text"
                                        android:textAlignment="viewStart"
                                        android:textColor="#ff000000"
                                        android:textSize="16sp" />

                                    <androidx.cardview.widget.CardView
                                        android:id="@+id/cv_recharge_amt_lyt"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8.0dip"
                                        android:layout_marginTop="10.0dip"
                                        android:layout_marginEnd="8.0dip"
                                        android:paddingStart="5.0dip"
                                        android:paddingEnd="5.0dip"
                                        app:cardBackgroundColor="#ffffffff">

                                        <LinearLayout
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:paddingTop="15.0dip"
                                            android:paddingBottom="15.0dip">

                                            <com.instaguard.provider.CustomViews.CustomEditText
                                                android:id="@+id/edt_recharge_amt"
                                                android:layout_width="fill_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="5.0dip"
                                                android:layout_marginEnd="5.0dip"
                                                android:hint="@string/my_wallet_recharge_amount_hint"
                                                android:imeOptions="actionDone"
                                                android:inputType="number"
                                                android:maxLength="6"
                                                android:singleLine="true"
                                                android:textAlignment="viewStart"
                                                app:met_floatingLabel="highlight"
                                                app:met_floatingLabelAlwaysShown="false"
                                                app:met_floatingLabelAnimating="true"
                                                app:met_textColorHint="@color/hintgray" />
                                        </LinearLayout>
                                    </androidx.cardview.widget.CardView>

                                    <LinearLayout
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="15.0dip">

                                        <com.instaguard.provider.CustomViews.CustomTextView
                                            android:id="@+id/txt_addmoney_one"
                                            android:layout_width="0.0dip"
                                            android:layout_height="45dp"
                                            android:layout_gravity="center_horizontal"
                                            android:layout_margin="8.0dip"
                                            android:layout_weight="1.0"
                                            android:background="@drawable/bg_wallet_border"
                                            android:gravity="center"
                                            android:paddingStart="25.0dip"
                                            android:paddingTop="10.0dip"
                                            android:paddingEnd="25.0dip"
                                            android:paddingBottom="10.0dip"
                                            android:text="300"
                                            android:textColor="#ffffffff"
                                            android:textSize="21.0sp" />

                                        <com.instaguard.provider.CustomViews.CustomTextView
                                            android:id="@+id/txt_addmoney_two"
                                            android:layout_width="0.0dip"
                                            android:layout_height="45dp"
                                            android:layout_gravity="center_horizontal"
                                            android:layout_margin="8.0dip"
                                            android:layout_weight="1.0"
                                            android:background="@drawable/bg_wallet_border"
                                            android:gravity="center"
                                            android:paddingStart="25.0dip"
                                            android:paddingTop="10.0dip"
                                            android:paddingEnd="25.0dip"
                                            android:paddingBottom="10.0dip"
                                            android:text="500"
                                            android:textColor="#ffffffff"
                                            android:textSize="21.0sp" />

                                        <com.instaguard.provider.CustomViews.CustomTextView
                                            android:id="@+id/txt_addmoney_three"
                                            android:layout_width="0.0dip"
                                            android:layout_height="45dp"
                                            android:layout_gravity="center_horizontal"
                                            android:layout_margin="8.0dip"
                                            android:layout_weight="1.0"
                                            android:background="@drawable/bg_wallet_border"
                                            android:gravity="center"
                                            android:paddingStart="25.0dip"
                                            android:paddingTop="10.0dip"
                                            android:paddingEnd="25.0dip"
                                            android:paddingBottom="10.0dip"
                                            android:text="1000"
                                            android:textColor="#ffffffff"
                                            android:textSize="21.0sp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <com.instaguard.provider.CustomViews.CustomTextView
                                            android:id="@+id/txt_policy"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="5.0dip"
                                            android:layout_marginBottom="5.0dip"
                                            android:gravity="center"
                                            android:text="@string/my_wallet_by_conducting_you_choose_to_accept_linq_auto_club_text"
                                            android:textColor="@android:color/holo_red_light"
                                            android:textSize="16sp" />

                                        <com.instaguard.provider.CustomViews.CustomTextView
                                            android:id="@+id/txt_terms"
                                            android:layout_width="fill_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="5.0dip"
                                            android:layout_marginBottom="5.0dip"
                                            android:gravity="center"
                                            android:text="@string/my_wallet_terms_amp_privacy_policy_text"
                                            android:textColor="@color/colorPrimary"
                                            android:textSize="16sp"
                                            android:visibility="gone" />
                                    </LinearLayout>

                                    <com.instaguard.provider.CustomViews.CustomButton
                                        android:id="@+id/btn_addmoney"
                                        android:layout_width="fill_parent"
                                        android:layout_height="45sp"
                                        android:layout_gravity="bottom"
                                        android:layout_marginStart="8.0dip"
                                        android:layout_marginTop="10.0dip"
                                        android:layout_marginEnd="8.0dip"
                                        android:background="@drawable/bg_rect_filled_colorprimary"
                                        android:text="@string/my_wallet_add_money_btn_text"
                                        android:textAllCaps="true"
                                        android:textColor="@color/white" />


                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_wallet_all"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior"
                        tools:listitem="@layout/adapter_wallet_history" />

                    <RelativeLayout
                        android:id="@+id/rl_emptyview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:visibility="gone">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:text="@string/no_record_found"
                            android:textColor="@color/black" />
                    </RelativeLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </RelativeLayout>

</RelativeLayout>