<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white">

    <android.widget.Toolbar
        android:id="@+id/toolbar_checkin"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@drawable/bg_toolbar_gradient"
        android:elevation="0dp"
        android:visibility="visible"
        app:contentInsetLeft="20dp"
        app:contentInsetStart="20dp"
        app:contentInsetStartWithNavigation="20dp"
        tools:ignore="UnusedAttribute">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/img_menu"
                style="@style/AppThemeToolBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:layout_marginTop="5dp"
                android:contentDescription="@string/todo"
                android:onClick="menubuttonClick"
                android:padding="10dp"
                android:src="@drawable/ic_menu_black"
                tools:ignore="content_description" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/img_menu"
                android:layout_alignBottom="@+id/img_menu"
                android:layout_toStartOf="@+id/iv_alert"
                android:layout_toEndOf="@+id/img_menu"
                android:contentDescription="@string/todo"
                android:padding="5dp"
                android:src="@drawable/logo" />

            <com.instaguard.provider.CustomViews.CustomTextView
                android:id="@+id/toolbar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/img_menu"
                android:layout_alignBottom="@+id/img_menu"
                android:layout_gravity="center"
                android:layout_toStartOf="@+id/iv_alert"
                android:layout_toEndOf="@+id/img_menu"
                android:gravity="center"
                android:text="@string/app_name_toolbar"
                android:textAllCaps="true"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_alert"
                style="@style/AppThemeToolBar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_margin="5dp"
                android:visibility="invisible"
                android:contentDescription="@string/todo"
                android:padding="10dp"
                android:src="@mipmap/ic_eme_alert"
                app:tint="@android:color/holo_red_dark" />
        </RelativeLayout>
    </android.widget.Toolbar>

