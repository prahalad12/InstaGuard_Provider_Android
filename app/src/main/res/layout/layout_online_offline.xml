    <RelativeLayout
        android:id="@+id/ufxarea"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@+id/toolbar_checkin"
        android:background="@color/bg_gray_common"
        android:visibility="visible">

        <RelativeLayout
            android:id="@+id/activearea"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            tools:ignore="UselessParent">

            <RelativeLayout
                android:id="@+id/imagearea"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/backCoverImage"
                    android:layout_width="fill_parent"
                    android:layout_height="170.0dip"
                    android:background="@drawable/bg_toolbar_gradient_bottom_top"
                    android:contentDescription="@string/todo"
                    android:scaleType="fitXY" />
                <!--                    android:background="@drawable/bg_toolbar_gradient_bottom_top"
-->

                <FrameLayout
                    android:id="@+id/headerArea"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="50.0dip">

                    <com.instaguard.provider.CustomViews.CustomTextView
                        android:id="@+id/txt_drivername_online"
                        style="@style/AppThemeToolBarCenter"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10.0dip"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/app_name"
                        android:textStyle="bold" />
                </FrameLayout>

                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/iv_prof_pic_online"
                    android:layout_width="110.0dip"
                    android:layout_height="110.0dip"
                    android:layout_alignParentTop="true"
                    android:layout_centerInParent="true"
                    android:layout_marginTop="100.0dip"
                    android:scaleType="fitXY"
                    app:placeholderImage="@mipmap/male"
                    app:placeholderImageScaleType="fitXY"
                    app:roundedCornerRadius="0dp" />

                <!-- app:sriv_border_color="@color/appThemeColor_TXT_2"
                 app:sriv_border_width="2.0dip"
                 app:sriv_left_bottom_corner_radius="20.0dip"
                 app:sriv_left_top_corner_radius="20.0dip"
                 app:sriv_oval="true"
                 app:sriv_right_bottom_corner_radius="20.0dip"
                 app:sriv_right_top_corner_radius="20.0dip"-->
                <ImageView
                    android:id="@+id/tempbackCoverImage"
                    android:layout_width="fill_parent"
                    android:layout_height="170.0dip"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:background="#bf000000"
                    android:contentDescription="@string/todo"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

            </RelativeLayout>

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/botomarea"
                android:layout_below="@+id/imagearea"
                android:layout_marginTop="5.0dip"
                android:background="@color/white"
                android:scrollbars="none">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/switcharea"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/bg_gray_common"
                        android:orientation="vertical">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_onlineoffline"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10.0dip"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Offline"
                            android:textAllCaps="true"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.kyleduo.switchbutton.SwitchButton
                            android:id="@+id/switch_online_offline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="10.0dip"
                            android:layout_marginBottom="15.0dip"
                            app:kswBackColor="@android:color/holo_red_dark"
                            app:kswThumbColor="@android:color/white" />

                        <!--app:kswBackColor="@android:color/holo_red_dark"
                            app:kswBackMeasureRatio="3.0"
                            app:kswThumbColor="@android:color/white"
                            app:kswThumbHeight="30.0dip"
                            app:kswThumbWidth="30.0dip"-->
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_getting_location"
                        android:layout_width="fill_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/switcharea"
                        android:layout_alignParentBottom="true"
                        android:foregroundGravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="45.0dip"
                        android:paddingBottom="30.0dip"
                        android:visibility="visible">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_check_geofence"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5.0dip"
                            android:layout_marginBottom="5.0dip"
                            android:gravity="center"
                            android:maxLines="1"
                            android:padding="5dp"
                            android:text="Check Geofence"
                            android:visibility="gone"
                            android:textAllCaps="true"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/joblocHTxtView"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5.0dip"
                            android:layout_marginBottom="5.0dip"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/your_work_location"
                            android:textAllCaps="true"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0.0dip"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.0">

                                <LinearLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <com.instaguard.provider.CustomViews.CustomTextView
                                        android:id="@+id/addressTxtView"
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5.0dip"
                                        android:gravity="center"
                                        android:paddingStart="5.0dip"
                                        android:paddingEnd="5.0dip"
                                        android:paddingBottom="5.0dip"
                                        android:text="@string/mainactivity_getting_location"
                                        android:textColor="#ff161515"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        tools:ignore="TooDeepLayout" />

                                    <LinearLayout
                                        android:layout_width="fill_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:visibility="gone">

                                        <com.instaguard.provider.CustomViews.CustomTextView
                                            android:id="@+id/radiusTxtView"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:layout_marginTop="5.0dip"
                                            android:layout_marginBottom="3.0dip"
                                            android:gravity="start|center"
                                            android:maxLines="1"
                                            android:padding="5.0dip"

                                            android:text="@string/with_in_15km_radius"
                                            android:textColor="#ff161515"
                                            android:textSize="16sp"
                                            android:textStyle="bold" />

                                        <ImageView
                                            android:id="@+id/imageradius"
                                            android:layout_width="34.0dip"
                                            android:layout_height="34.0dip"
                                            android:layout_gravity="bottom"
                                            android:contentDescription="@string/todo"
                                            android:scaleType="fitXY"
                                            android:src="@mipmap/ic_edit"
                                            app:tint="@color/colorPrimary" />
                                    </LinearLayout>

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_not_approved"
                        android:layout_width="fill_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/switcharea"
                        android:layout_centerHorizontal="true"
                        android:background="#FFF"
                        android:foregroundGravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="45.0dip"
                        android:paddingBottom="30.0dip"
                        android:visibility="gone">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_approved"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5.0dip"
                            android:layout_marginBottom="5.0dip"
                            android:gravity="center"
                            android:maxLines="5"
                            android:text="@string/you_are_not_approved_by_admin_n_n_please_contact_admin"
                            android:textAllCaps="true"
                            android:textColor="@color/colorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_doc_approved"
                        android:layout_width="fill_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/ll_not_approved"
                        android:background="@color/holo_red_dark"
                        android:layout_marginTop="5dp"
                        android:foregroundGravity="center"
                        android:orientation="vertical"
                        android:paddingTop="45.0dip"
                        android:paddingBottom="30.0dip"
                        android:visibility="gone">

                        <com.instaguard.provider.CustomViews.CustomTextView
                            android:id="@+id/txt_doc_approved"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5.0dip"
                            android:layout_marginBottom="5.0dip"
                            android:gravity="center"
                            android:maxLines="5"
                            android:text="@string/you_are_not_approved_by_admin_n_n_please_contact_admin"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </RelativeLayout>

            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/botomarea"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_update_currency_setup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:background="@color/colorPrimaryDark"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="@string/update_your_currency_setup"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_update_language_setup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="0dp"
                    android:background="@color/colorPrimaryDark"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="@string/update_language_setup"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_update_avialbility_setup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="0dp"
                    android:background="@color/colorPrimaryDark"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="@string/myavailablitysub_header"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/update_subscription_setup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="0dp"
                    android:background="@color/colorPrimaryDark"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="@string/your_subs_plan"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.1dp"
                        android:background="#000" />

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:layout_weight="1.0">

                            <RelativeLayout
                                android:id="@+id/rl_pending_area"
                                android:layout_width="fill_parent"
                                android:layout_height="fill_parent"
                                android:padding="10.0dip">

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_pending_count"
                                    android:layout_width="50.0dip"
                                    android:layout_height="50.0dip"
                                    android:layout_centerHorizontal="true"
                                    android:background="@drawable/bg_roundshape"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:text="0"
                                    android:textAllCaps="true"
                                    android:textColor="#ffb64fc4"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/pimage"
                                    android:layout_width="50.0dip"
                                    android:layout_height="50.0dip"
                                    android:layout_centerHorizontal="true"
                                    android:contentDescription="@string/todo"
                                    android:visibility="invisible" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/pendingjobHTxtView"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/txt_pending_count"
                                    android:layout_marginTop="5.0dip"
                                    android:layout_marginBottom="5.0dip"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:text="@string/pending_jobs"
                                    android:textAllCaps="true"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                        </LinearLayout>

                        <View
                            android:layout_width="0.1dp"
                            android:layout_height="match_parent"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="0dp"
                            android:visibility="gone"
                            android:background="#000" />

                        <LinearLayout
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0">

                            <RelativeLayout
                                android:id="@+id/rl_upcoming_area"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:padding="10.0dip">

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/txt_upcoming_count"
                                    android:layout_width="50.0dip"
                                    android:layout_height="50.0dip"
                                    android:layout_centerHorizontal="true"
                                    android:background="@drawable/bg_roundshape"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:layout_toStartOf="@+id/uimage"
                                    android:text="0"
                                    android:textAllCaps="true"
                                    android:textColor="#ffb64fc4"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/uimage"
                                    android:layout_width="50.0dip"
                                    android:layout_height="50.0dip"
                                    android:layout_centerHorizontal="true"
                                    android:layout_alignParentEnd="true"
                                    android:visibility="gone" />

                                <com.instaguard.provider.CustomViews.CustomTextView
                                    android:id="@+id/upcomingjobHTxtView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@+id/txt_upcoming_count"
                                    android:layout_alignTop="@+id/txt_upcoming_count"
                                    android:layout_alignBottom="@+id/txt_upcoming_count"
                                    android:layout_marginTop="5.0dip"
                                    android:layout_marginBottom="5.0dip"
                                    android:layout_marginEnd="15.0dip"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:text="@string/upcoming_jobs"
                                    android:textAllCaps="true"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>