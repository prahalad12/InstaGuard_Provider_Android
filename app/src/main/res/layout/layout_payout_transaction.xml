<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/_4sdp"
        android:layout_margin="@dimen/_8sdp"
        app:cardCornerRadius="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary_light">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/refNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refference_no"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/gray"
                android:layout_margin="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/refNoShow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/gray"
                android:layout_marginStart="@dimen/_4sdp"
                app:layout_constraintStart_toEndOf="@id/refNo"
                app:layout_constraintTop_toTopOf="@+id/refNo"
                app:layout_constraintBottom_toBottomOf="@+id/refNo"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="pending"
                android:textStyle="bold"
                android:background="@drawable/bg_status"
                android:textColor="@color/white_"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:paddingTop="@dimen/_3sdp"
                android:paddingBottom="@dimen/_4sdp"
                android:textSize="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@+id/refNo"
                app:layout_constraintTop_toTopOf="@+id/refNo"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/statusDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/refNo"
                app:layout_constraintEnd_toEndOf="@+id/status"
                app:layout_constraintTop_toBottomOf="@+id/status"
                android:layout_marginTop="10sp"
                android:layout_marginBottom="@dimen/_6sdp"
                app:layout_constraintBottom_toTopOf="@+id/payAmtTxt"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09.30"
                android:textColor="@color/gray"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/payAmtTxt"
                app:layout_constraintBottom_toBottomOf="@+id/payAmtTxt"
                android:layout_marginEnd="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aug 31 2024"
                android:textColor="@color/gray"
                android:textSize="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                app:layout_constraintTop_toTopOf="@+id/time"
                app:layout_constraintBottom_toBottomOf="@+id/time"
                app:layout_constraintEnd_toStartOf="@+id/time"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/payAmtTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payout_amount"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="@+id/refNo"
                app:layout_constraintTop_toBottomOf="@+id/statusDesc"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="@dimen/_10sdp"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/payoutAmt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:text="12"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@+id/payAmtTxt"
                app:layout_constraintBottom_toBottomOf="@+id/payAmtTxt"
                app:layout_constraintStart_toEndOf="@+id/payAmtTxt"
                android:layout_marginStart="@dimen/_4sdp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>