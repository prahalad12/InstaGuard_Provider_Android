<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!--Received from other side-->
    <FrameLayout
        android:id="@+id/left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:paddingStart="16dp"
        android:paddingEnd="72dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/bubble_"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:orientation="vertical"
                android:padding="8dp">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/btn_message_boddy1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:hint="@string/app_name"
                    android:padding="2dp"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="14sp" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_message_time1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:gravity="start"
                    android:hint="@string/app_name"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="12sp" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_message_time_from_customer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center"
                    android:layout_marginStart="0dp"
                    android:gravity="center|start"
                    android:hint="@string/user"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingBottom="3dp"
                    android:text="@string/user"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!--User typing our side-->
    <FrameLayout
        android:id="@+id/right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingStart="72dp"
        android:paddingEnd="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical"
                android:padding="8dp">

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/btn_message_boddy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:gravity="end"
                    android:hint="@string/app_name"
                    android:padding="2dp"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="14sp" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_message_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/btn_message_boddy"
                    android:layout_gravity="end"
                    android:layout_margin="2dp"
                    android:gravity="end"
                    android:hint="@string/app_name"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="12sp" />

                <com.instaguard.provider.CustomViews.CustomTextView
                    android:id="@+id/txt_message_time_you"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="10dp"
                    android:gravity="end"
                    android:hint="@string/you"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingBottom="3dp"
                    android:text="@string/you"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!--<Space
                    android:layout_width="match_parent"
                    android:layout_height="4dp" />

                <TextView
                    android:id="@+id/timestamp_text_view"
                    tools:text="12:10 am"
                    android:textSize="@dimen/default_timestamp_text_size"
                    android:textColor="@color/default_tstamp_color_send"
                    android:gravity="center_vertical|start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />-->

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

</LinearLayout>